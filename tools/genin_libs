#! /usr/bin/env bash
# genin_libs: generate make/libs/external.in.generated
# Discovers all make/libs/*/external.in and make/pkgs/*/external.in.libs
# files and emits them sorted alphabetically by library/package name.
# Only updates the output file when content actually changes (preserves
# timestamps to avoid spurious kconfig cache invalidation).

EFILE=make/libs/external.in.generated

[ ! -d make/libs ] && exit 1

{
	printf 'comment "libraries"\n\tdepends on EXTERNAL_ENABLED\n'
	{
		find make/libs -mindepth 2 -maxdepth 2 -name "external.in"
		find make/pkgs -mindepth 2 -maxdepth 2 -name "external.in.libs"
	} | awk -F'/' '{print $3, $0}' | sort | awk '{print $2}' | \
		while read -r f; do echo "source \"$f\""; done
	echo ""
} > "${EFILE}.tmp"

if ! cmp -s "${EFILE}.tmp" "${EFILE}" 2>/dev/null; then
	echo -n "genin_libs " >&2
	mv "${EFILE}.tmp" "${EFILE}"
else
	rm -f "${EFILE}.tmp"
fi
