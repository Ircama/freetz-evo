#!/usr/bin/env bash
# Compatibility wrapper: keep CLI path stable while implementation lives in Python.

set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY_IMPL="${SCRIPT_DIR}/freetz_translate.py"
export FREETZ_TRANSLATE_PROGNAME="${FREETZ_TRANSLATE_PROGNAME:-$0}"

if command -v python3 >/dev/null 2>&1; then
	exec python3 "$PY_IMPL" "$@"
elif command -v python >/dev/null 2>&1; then
	exec python "$PY_IMPL" "$@"
else
	echo "freetz_translate: ERROR: python interpreter not found" >&2
	exit 1
fi
