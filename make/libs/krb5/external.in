config EXTERNAL_FREETZ_LIB_libkrb5
	depends on EXTERNAL_ENABLED && FREETZ_LIB_libkrb5
	bool "libkrb5"
	default n
	help
		externals the following file(s):
		 ${FREETZ_LIBRARY_DIR}/libcom_err.so.3.0
		 ${FREETZ_LIBRARY_DIR}/libk5crypto.so.3.1
		 ${FREETZ_LIBRARY_DIR}/libkrb5support.so.0.1
		 ${FREETZ_LIBRARY_DIR}/libkrb5.so.3.3

config EXTERNAL_FREETZ_LIB_libgssapi_krb5
	depends on EXTERNAL_ENABLED && FREETZ_LIB_libgssapi_krb5
	bool "libgssapi_krb5"
	default n
	help
		externals the following file(s):
		 ${FREETZ_LIBRARY_DIR}/libgssapi_krb5.so.2.2
