config FREETZ_LIB_libboost_thread
	bool "boost (headers, libboost_thread, libboost_system)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	default n
	select FREETZ_LIB_libboost_system
	help
		Boost 1.87.0 C++ libraries, cross-built with b2 exactly like the Boost
		copy bundled in this tree by the pdns-recursor package.

		Installs the complete Boost header tree below /usr/include/boost plus:
		  - libboost_thread.so (Boost.Thread, requires nptl pthreads)
		  - libboost_system.so (Boost.System)

		A minimal CMake package config is installed into the staging prefix as
		well, because CMake 4.x no longer ships the FindBoost module. CMake
		based consumers therefore use:

		  find_package(Boost CONFIG REQUIRED COMPONENTS thread)

		Required by the Domoticz package (Boost.Asio, Boost.Signals2 and
		Boost.Thread are used throughout its source).

config FREETZ_LIB_libboost_system
	bool
	default n
	select FREETZ_LIB_libpthread if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	help
		Boost.System shared library.

		boost::system is header-only since Boost 1.69, so this library is only
		needed by consumers that link it explicitly. It is selected
		automatically together with libboost_thread.

		The whole header tree and both libraries are provided by the single
		"boost" package.
