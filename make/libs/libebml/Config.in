config FREETZ_LIB_libebml
	bool "libebml (EBML parser library)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	default n
	help
		libebml is a C++ library for parsing EBML (Extensible Binary
		Markup Language) data, used as the foundation for Matroska
		container format.

		Requires uClibc 1.0.58 or newer (libebml 1.4.5 sets
		CMAKE_CXX_STANDARD 14 in CMakeLists.txt, which the old GCC
		4.6.4 toolchain does not support).
		
		https://github.com/Matroska-Org/libebml
