[ "$EXTERNAL_FREETZ_LIB_libtcl" == "y" -a -f "${FILESYSTEM_MOD_DIR}${FREETZ_LIBRARY_DIR}/libtcl8.6.so" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libtcl8.6.so"
[ "$EXTERNAL_FREETZ_LIB_libtcl" == "y" -a -d "${FILESYSTEM_MOD_DIR}/usr/lib/tcl8.6" ] && EXTERNAL_FILES+=" /usr/lib/tcl8.6/"
[ "$EXTERNAL_FREETZ_LIB_libtcl" == "y" -a -d "${FILESYSTEM_MOD_DIR}/usr/lib/tcl8" ] && EXTERNAL_FILES+=" /usr/lib/tcl8/"
