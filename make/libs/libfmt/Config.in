config FREETZ_LIB_libfmt
	bool "fmt (C++ formatting library)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	default n
	help
		libfmt is a modern C++ formatting library providing
		a fast and safe alternative to C stdio and C++ iostreams.
		
		Required by spdlog and Gerbera.
		
		Requires uClibc 1.0.58 or newer (it needs a recent C++
		compiler, not available on the older toolchains).
		
		https://fmt.dev/
