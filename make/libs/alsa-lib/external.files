[ "$EXTERNAL_FREETZ_LIB_libasound" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libasound.so.2.0.0"
[ "$EXTERNAL_FREETZ_LIB_libasound" == "y" -a "$EXTERNAL_SUBDIRS" == "y" ] && EXTERNAL_FILES+=" /usr/share/alsa"
[ "$EXTERNAL_FREETZ_LIB_libasound" == "y" -a -d "${FILESYSTEM_MOD_DIR}/usr/lib/alsa-lib" ] && EXTERNAL_FILES+=" /usr/lib/alsa-lib/"