 static void hidapi_thread_barrier_wait(hidapi_thread_state *state)
 {
-	pthread_barrier_wait(&state->barrier);
+	/* 2-party barrier implemented with a mutex+cond handshake.
+	   pthread_barrier_* are declared by old uClibc (0.9.x, e.g.
+	   0.9.32.1 on 3270v3) but NOT implemented there, causing
+	   undefined references at link time (e.g. avrdude). Using only
+	   pthread_mutex/pthread_cond works on every libc, so this is
+	   applied unconditionally (no regression on modern toolchains). */
+	pthread_mutex_lock(&state->barrier_mutex);
+	state->barrier_count++;
+	if (state->barrier_count == 2) {
+		state->barrier_count = 0;
+		pthread_cond_broadcast(&state->barrier_cond);
+		pthread_mutex_unlock(&state->barrier_mutex);
+	} else {
+		while (state->barrier_count != 0)
+			pthread_cond_wait(&state->barrier_cond, &state->barrier_mutex);
+		pthread_mutex_unlock(&state->barrier_mutex);
+	}
 }
 
