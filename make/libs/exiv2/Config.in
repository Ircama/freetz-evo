config FREETZ_LIB_libexiv2
	bool "exiv2 (image metadata library)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	select FREETZ_LIB_libexpat
	select FREETZ_LIB_libz
	default n
	help
		Exiv2 is a C++ library for reading and writing image metadata,
		supporting Exif, IPTC, XMP, ICC profiles and more.
		
		Requires uClibc 1.0.58 or newer (older uClibc versions fail to
		compile exiv2 0.28.x due to -Werror=sign-compare warnings).
		
		https://exiv2.org/
