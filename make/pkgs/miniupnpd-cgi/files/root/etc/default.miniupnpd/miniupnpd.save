#!/bin/sh

pkg_pre_save() {
	# Validate interfaces
	if [ "$MINIUPNPD_ENABLED" = "yes" ]; then
		if [ -z "$MINIUPNPD_WAN_IF" ]; then
			echo "Error: WAN interface required when enabled" >&2
			return 1
		fi
		if [ -z "$MINIUPNPD_LAN_IF" ]; then
			echo "Error: LAN interface required when enabled" >&2
			return 1
		fi
	fi
	return 0
}

pkg_apply_save() {
	[ -r /mod/etc/conf/miniupnpd.cfg ] && . /mod/etc/conf/miniupnpd.cfg

	local conf_file="/etc/default.miniupnpd/miniupnpd.conf"
	mkdir -p "$(dirname "$conf_file")" 2>/dev/null

	{
		echo "# MiniUPnPd configuration - generated by freetz"
		echo "ext_ifname=${MINIUPNPD_WAN_IF:-eth1}"
		echo "listening_ip=${MINIUPNPD_LAN_IF:-192.168.0.1/24}"
		echo "enable_upnp=${MINIUPNPD_ENABLE_UPNP:-yes}"
		echo "enable_pcp_pmp=${MINIUPNPD_ENABLE_PCP_PMP:-yes}"
		echo "secure_mode=${MINIUPNPD_SECURE_MODE:-yes}"
		echo "lease_file=/var/log/upnp.leases"
		echo "notify_interval=${MINIUPNPD_NOTIFY_INTERVAL:-900}"
		echo "clean_ruleset_interval=${MINIUPNPD_CLEAN_INTERVAL:-600}"
		echo "system_uptime=yes"
		echo "allow 1024-65535 192.168.0.0/24 1024-65535"
		echo "deny 0-65535 0.0.0.0/0 0-65535"
	} > "$conf_file"

	# Restart daemon to apply config
	/etc/init.d/rc.miniupnpd restart 2>/dev/null || true

	return 0
}
