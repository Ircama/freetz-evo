config FREETZ_PACKAGE_MINIUPNPD_CGI
	bool "MiniUPnPd CGI web configuration interface"
	depends on FREETZ_PACKAGE_MINIUPNPD_DAEMON
	select FREETZ_BUSYBOX_START_STOP_DAEMON
	default n
	help
		Provides a web configuration interface for MiniUPnPd.

		Access the configuration (e.g., http://fritz.box:81/cgi-bin/conf/miniupnpd)
