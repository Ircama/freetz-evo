config FREETZ_PACKAGE_MPD
	bool "MPD 0.24.13"
	depends on FREETZ_TARGET_GCC_13_MIN
	select FREETZ_STDCXXLIB_FORCE_GNULIBSTDCXX
	select FREETZ_LIB_STDCXXLIB
	select FREETZ_LIB_libjemalloc
	select FREETZ_LIB_libpthread  if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libm        if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libasound
	select FREETZ_LIB_libFLAC
	select FREETZ_LIB_libid3tag
	select FREETZ_LIB_libmad
	select FREETZ_LIB_libogg
	select FREETZ_LIB_libvorbis
	select FREETZ_LIB_libz
	select FREETZ_MODULE_snd_usb_audio if FREETZ_MODULES_AUDIO_AVAILABLE
	default n
	help
		Music Player Daemon is a network-controllable music player.

		This build enables the local database, TCP control interface,
		ALSA output and the MP3, FLAC and Vorbis decoders.
		jemalloc is selected to work around allocator-related crashes
		observed on some uClibc target combinations.
		Libcurl-based URI input support, SQLite, FFmpeg, ICU, WavPack,
		UPnP, Expat, Opus, iconv, Vorbis encoder, FAAD2, FluidSynth,
		libsamplerate, mpg123, NFS, shine, shout, soxr, Tremor,
		WildMIDI, WebDAV, IPv6, DSD, CUE, pipe, FIFO and HTTP output
		can be enabled in the sub-options below.

		Can be externalized to save flash memory.

if FREETZ_PACKAGE_MPD

	config FREETZ_PACKAGE_MPD_WITH_URI_INPUTS
		bool "Enable remote URI input support (libcurl)"
		select FREETZ_LIB_libcurl
		select FREETZ_LIB_libcurl_WITH_SSL
		select FREETZ_LIB_libcurl_WITH_CA_BUNDLE
		default y
		help
			Enables MPD's libcurl input backend for remote URIs such as
			http:// and https:// streams and playlists.

			This keeps heavier upstream integrations such as WebDAV, MMS,
			UPnP and FFmpeg disabled.

	config FREETZ_PACKAGE_MPD_WITH_SQLITE
		bool "Enable SQLite database plugin"
		select FREETZ_LIB_libsqlite3
		default n
		help
			Enables MPD's optional SQLite database backend.

	config FREETZ_PACKAGE_MPD_WITH_BZIP2
		bool "Enable bzip2 compressed playlist/archive support"
		select FREETZ_LIB_libbz2
		default n
		help
			Enables MPD's optional bzip2 support.

	config FREETZ_PACKAGE_MPD_WITH_FFMPEG
		bool "Enable FFmpeg decoder integration"
		select FREETZ_PACKAGE_FFMPEG_PATENTED
		select FREETZ_PACKAGE_FFMPEG_DECODER_aac
		select FREETZ_PACKAGE_FFMPEG_PARSER_aac
		select FREETZ_PACKAGE_FFMPEG_DEMUXER_aac
		select FREETZ_PACKAGE_FFMPEG_DEMUXER_hls
		select FREETZ_LIB_libavcodec
		select FREETZ_LIB_libavformat
		select FREETZ_LIB_libavutil
		default n
		help
			Enables MPD's optional FFmpeg decoder backend.

			This uses the FFmpeg library set configured in Freetz and
			is intended for users who want broader format coverage than
			the built-in MP3/FLAC/Vorbis stack, including AAC/HLS
			radio streams.

	config FREETZ_PACKAGE_MPD_WITH_ICU
		bool "Enable ICU (Unicode) support"
		depends on FREETZ_SHOW_DEVELOPER && FREETZ_TARGET_UCLIBC_1_0_58_MIN
		select FREETZ_LIB_libicu
		default n
		help
			Enables ICU support in MPD for Unicode string
			transliteration and case-insensitive matching.

	config FREETZ_PACKAGE_MPD_WITH_WAVPACK
		bool "Enable WavPack decoder"
		select FREETZ_LIB_libwavpack
		default n
		help
			Enables MPD's WavPack lossless audio decoder.

	config FREETZ_PACKAGE_MPD_WITH_UPNP
		bool "Enable UPnP Media Server"
		select FREETZ_LIB_libupnp
		default n
		help
			Enables MPD's UPnP Media Server capability.

	config FREETZ_PACKAGE_MPD_WITH_EXPAT
		bool "Enable Expat XML parser"
		select FREETZ_LIB_libexpat
		default n
		help
			Enables Expat XML parser support in MPD.

	config FREETZ_PACKAGE_MPD_WITH_OPUS
		bool "Enable Opus decoder"
		select FREETZ_LIB_libopus
		default n
		help
			Enables MPD's Opus audio decoder.

	config FREETZ_PACKAGE_MPD_WITH_ICONV
		bool "Enable iconv charset conversion"
		select FREETZ_LIB_libiconv
		default n
		help
			Enables character set conversion support via iconv.

	config FREETZ_PACKAGE_MPD_WITH_VORBISENC
		bool "Enable Vorbis encoder"
		select FREETZ_LIB_libvorbisenc
		default n
		help
			Enables MPD's Vorbis audio encoder (for the
			HTTP output plugin).

	config FREETZ_PACKAGE_MPD_WITH_IPV6
		bool "Enable IPv6 support"
		default n
		help
			Enables IPv6 support in MPD's TCP listener.

	config FREETZ_PACKAGE_MPD_WITH_DSD
		bool "Enable DSD support"
		default n
		help
			Enables DSD (Direct Stream Digital) support
			in MPD's ALSA output plugin.

	config FREETZ_PACKAGE_MPD_WITH_CUE
		bool "Enable CUE sheet support"
		default n
		help
			Enables CUE sheet parsing support in MPD.

	config FREETZ_PACKAGE_MPD_WITH_NEIGHBOR
		bool "Enable UPnP neighbor discovery"
		depends on FREETZ_PACKAGE_MPD_WITH_UPNP
		default n
		help
			Enables MPD's UPnP neighbor discovery (requires UPnP).

	config FREETZ_PACKAGE_MPD_WITH_WEBDAV
		bool "Enable WebDAV input"
		depends on FREETZ_PACKAGE_MPD_WITH_URI_INPUTS
		default n
		help
			Enables MPD's WebDAV input backend (requires curl).

	config FREETZ_PACKAGE_MPD_WITH_PIPE
		bool "Enable named pipe output"
		default n
		help
			Enables MPD's named pipe audio output plugin.

	config FREETZ_PACKAGE_MPD_WITH_FIFO
		bool "Enable FIFO output"
		default n
		help
			Enables MPD's FIFO audio output plugin.

	config FREETZ_PACKAGE_MPD_WITH_HTTPD
		bool "Enable HTTP daemon output"
		default n
		help
			Enables MPD's HTTP streaming audio output plugin.

	config FREETZ_PACKAGE_MPD_WITH_FAAD
		bool "Enable FAAD2 (AAC) decoder"
		select FREETZ_LIB_libfaad2
		default n
		help
			Enables MPD's FAAD2 AAC audio decoder.

	config FREETZ_PACKAGE_MPD_WITH_FLUIDSYNTH
		bool "Enable FluidSynth (MIDI) decoder"
		select FREETZ_LIB_libfluidsynth
		default n
		help
			Enables MPD's FluidSynth MIDI synthesis decoder.

	config FREETZ_PACKAGE_MPD_WITH_LIBSAMPLERATE
		bool "Enable libsamplerate (SRC) output"
		select FREETZ_LIB_libsamplerate
		default n
		help
			Enables MPD's libsamplerate-based sample rate conversion.

	config FREETZ_PACKAGE_MPD_WITH_MPG123
		bool "Enable mpg123 (MP3) decoder"
		select FREETZ_LIB_libmpg123
		default n
		help
			Enables MPD's mpg123 MP3 audio decoder.

	config FREETZ_PACKAGE_MPD_WITH_NFS
		bool "Enable NFS input"
		select FREETZ_LIB_libnfs
		default n
		help
			Enables MPD's NFS input backend.

	config FREETZ_PACKAGE_MPD_WITH_SHINE
		bool "Enable shine (MP3) encoder"
		select FREETZ_LIB_libshine
		default n
		help
			Enables MPD's shine fixed-point MP3 encoder.

	config FREETZ_PACKAGE_MPD_WITH_SHOUT
		bool "Enable Icecast (shout) output"
		select FREETZ_LIB_libshout
		default n
		help
			Enables MPD's Icecast streaming output plugin.

	config FREETZ_PACKAGE_MPD_WITH_SOXR
		bool "Enable libsoxr (SRC) output"
		select FREETZ_LIB_libsoxr
		default n
		help
			Enables MPD's libsoxr sample rate converter.

	config FREETZ_PACKAGE_MPD_WITH_TREMOR
		bool "Enable Tremor (low-memory Vorbis) decoder"
		select FREETZ_LIB_libvorbisidec
		default n
		help
			Enables MPD's Tremor low-memory Vorbis decoder.

	config FREETZ_PACKAGE_MPD_WITH_WILDMIDI
		bool "Enable WildMIDI decoder"
		select FREETZ_LIB_libwildmidi
		default n
		help
			Enables MPD's WildMIDI software MIDI playback.

config FREETZ_PACKAGE_MPD_CGI
	bool "MPD CGI (Music Player Daemon config/status web UI)"
	default y
	help
		Provides the freetz CGI configuration page and status page for MPD.
		This is the same symbol shown in "Packages -> Web interfaces".

endif