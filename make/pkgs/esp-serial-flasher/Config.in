config FREETZ_PACKAGE_ESP_SERIAL_FLASHER
	bool "esp-serial-flasher"
	default n
	help
		ESP Serial Flasher for Linux hosts.
		Builds one CLI tool:
                 - esp-flasher: generic CLI (<addr> <file> pairs). It drives the
                   esptool reset sequences itself, so an ESP32-C3/C6/H2/S3 on
                   native USB needs no BOOT/RESET button presses (--before and
                   --after select the strategy).
