+static uint32_t from_target_le32(uint32_t v)
+{
+#if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
+    return ((v & 0x000000FFU) << 24) |
+           ((v & 0x0000FF00U) << 8) |
+           ((v & 0x00FF0000U) >> 8) |
+           ((v & 0xFF000000U) >> 24);
+#else
+    return v;
+#endif
+}
+
 
