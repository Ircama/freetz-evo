config FREETZ_PACKAGE_PYTHON3_PARAMIKO
	bool "paramiko 5.0.0"
	depends on FREETZ_PACKAGE_PYTHON3
	select FREETZ_PACKAGE_PYTHON3_BCRYPT
	select FREETZ_PACKAGE_PYTHON3_CRYPTOGRAPHY
	select FREETZ_PACKAGE_PYTHON3_INVOKE
	select FREETZ_PACKAGE_PYTHON3_PYNACL
	default n
	help
		SSH2 protocol library (client and server) implemented in Python
		on top of cryptography: it opens SSH sessions and it runs commands
		on remote hosts, for example to list the clients of a router
		(used by domoticz-idetect).
