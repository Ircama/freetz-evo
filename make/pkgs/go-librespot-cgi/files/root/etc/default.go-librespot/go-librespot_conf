#!/bin/sh

escape_yaml() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

bool_yaml() {
	case "$1" in
		yes|true|1|on) echo true ;;
		*) echo false ;;
	esac
}

config_dir="${GO_LIBRESPOT_CONFIG_DIR%/}"
log_file="${config_dir}/go-librespot.log"

mkdir -p "$config_dir" 2>/dev/null

device_name_escaped="$(escape_yaml "$GO_LIBRESPOT_DEVICE_NAME")"
device_type_escaped="$(escape_yaml "$GO_LIBRESPOT_DEVICE_TYPE")"
audio_device_escaped="$(escape_yaml "$GO_LIBRESPOT_AUDIO_DEVICE")"
mixer_device_escaped="$(escape_yaml "$GO_LIBRESPOT_MIXER_DEVICE")"
mixer_control_escaped="$(escape_yaml "$GO_LIBRESPOT_MIXER_CONTROL_NAME")"
log_level_escaped="$(escape_yaml "$GO_LIBRESPOT_LOG_LEVEL")"

cat << EOF
log_level: "${log_level_escaped}"
device_name: "${device_name_escaped}"
device_type: "${device_type_escaped}"
audio_backend: "alsa"
audio_device: "${audio_device_escaped}"
bitrate: ${GO_LIBRESPOT_BITRATE}
volume_steps: ${GO_LIBRESPOT_VOLUME_STEPS}
initial_volume: ${GO_LIBRESPOT_INITIAL_VOLUME}
credentials:
  type: "zeroconf"
  zeroconf:
    persist_credentials: $(bool_yaml "$GO_LIBRESPOT_PERSIST_CREDENTIALS")
disable_autoplay: $(bool_yaml "$GO_LIBRESPOT_DISABLE_AUTOPLAY")
zeroconf_backend: "builtin"
EOF

[ -n "$GO_LIBRESPOT_MIXER_DEVICE" ] && printf 'mixer_device: "%s"\n' "$mixer_device_escaped"
[ -n "$GO_LIBRESPOT_MIXER_CONTROL_NAME" ] && printf 'mixer_control_name: "%s"\n' "$mixer_control_escaped"
[ -n "$GO_LIBRESPOT_AUDIO_BUFFER_TIME" ] && printf 'audio_buffer_time: %s\n' "$GO_LIBRESPOT_AUDIO_BUFFER_TIME"
[ -n "$GO_LIBRESPOT_AUDIO_PERIOD_COUNT" ] && printf 'audio_period_count: %s\n' "$GO_LIBRESPOT_AUDIO_PERIOD_COUNT"
[ -n "$GO_LIBRESPOT_ZEROCONF_PORT" ] && printf 'zeroconf_port: %s\n' "$GO_LIBRESPOT_ZEROCONF_PORT"

if [ -n "$GO_LIBRESPOT_ZEROCONF_INTERFACES" ]; then
	echo 'zeroconf_interfaces_to_advertise:'
	old_ifs="$IFS"
	IFS=', '
	for iface in $GO_LIBRESPOT_ZEROCONF_INTERFACES; do
		[ -n "$iface" ] || continue
		iface_escaped="$(escape_yaml "$iface")"
		printf '  - "%s"\n' "$iface_escaped"
	done
	IFS="$old_ifs"
fi

printf 'server:\n'
printf '  enabled: false\n'
printf '  address: "localhost"\n'
printf '  port: 0\n'
printf '  image_size: "default"\n'

printf '# Generated by Freetz for go-librespot. Log file: %s\n' "$log_file"