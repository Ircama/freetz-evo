#!/bin/sh

DAEMON=ble2uart_gateway
DAEMON_LONG_NAME=ble2uart_gateway
DAEMON_BIN=ble2uart-gateway
PID_FILE=/var/run/$DAEMON.pid
LOG=/tmp/rc.$DAEMON.log
. /etc/init.d/modlibrc

# Configuration written by the web interface (falls back to the defaults below)
[ -r /mod/etc/conf/$DAEMON.cfg ] && . /mod/etc/conf/$DAEMON.cfg

BLE2UART_GATEWAY_SERIAL="${BLE2UART_GATEWAY_SERIAL:-/dev/ttyACM0}"
BLE2UART_GATEWAY_BAUDRATE="${BLE2UART_GATEWAY_BAUDRATE:-115200}"
BLE2UART_GATEWAY_STORE="${BLE2UART_GATEWAY_STORE:-/var/media/ftp/ble2uart_gateway}"
BLE2UART_GATEWAY_STORE="${BLE2UART_GATEWAY_STORE%/}"
BLE2UART_GATEWAY_CONFIG_WAIT="${BLE2UART_GATEWAY_CONFIG_WAIT:-120}"

GATEWAY_BIN=/usr/bin/ble2uart-gateway
[ -x "$GATEWAY_BIN" ] || GATEWAY_BIN=/mod/external/usr/bin/ble2uart-gateway

store_is_persistent() {
	local path="$1"
	local fstype
	while [ ! -e "$path" ]; do
		path="${path%/*}"
		[ -n "$path" ] || path=/
	done
	fstype="$(df -T "$path" 2>/dev/null | awk 'NR > 1 { print $2; exit }')"
	case "$fstype" in
		''|tmpfs|ramfs|devtmpfs|rootfs|squashfs|overlay) return 1 ;;
	esac
}

setup_service_log() {
	local target="$BLE2UART_GATEWAY_STORE/rc.$DAEMON.log"
	local link_tmp="${LOG}.$$.link"
	local backup

	if [ -e "$LOG" ] && [ ! -L "$LOG" ]; then
		backup="$BLE2UART_GATEWAY_STORE/rc.$DAEMON.log.previous.$(date +%Y%m%d-%H%M%S).$$"
		if ! cp -p "$LOG" "$backup"; then
			echo "Cannot preserve the previous gateway log" >&2
			return 1
		fi
	fi
	if ! ln -s "$target" "$link_tmp"; then
		echo "Cannot create the gateway log link" >&2
		return 1
	fi
	if ! mv -f "$link_tmp" "$LOG"; then
		rm -f "$link_tmp"
		echo "Cannot install the gateway log link" >&2
		return 1
	fi
}

# Called by modlib_startdaemon before the daemon is spawned.
config() {
	# The store holds the device list with the bind keys (secrets) and the
	# exposed-id state: keep it private, and create a first configuration when
	# there is none, so that the web interface has something to edit.
	umask 077
	case "$BLE2UART_GATEWAY_STORE" in
		/var/media/ftp|/var/media/ftp/*)
			if ! store_is_persistent "$BLE2UART_GATEWAY_STORE"; then
				echo "Gateway storage is not on a mounted persistent filesystem: $BLE2UART_GATEWAY_STORE" >&2
				return 1
			fi
			;;
	esac
	mkdir -p "$BLE2UART_GATEWAY_STORE" || return 1
	chmod 700 "$BLE2UART_GATEWAY_STORE" || return 1
	setup_service_log || return 1
	if [ ! -s "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" ]; then
		"$GATEWAY_BIN" --write-default-config "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" \
			>>$LOG 2>&1
		"$GATEWAY_BIN" --config "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" --set "serial.port=$BLE2UART_GATEWAY_SERIAL" >>$LOG 2>&1 || return 1
		"$GATEWAY_BIN" --config "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" --set "serial.baudrate=$BLE2UART_GATEWAY_BAUDRATE" >>$LOG 2>&1 || return 1
		chmod 600 "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" 2>/dev/null
	fi

	[ "$BLE2UART_GATEWAY_VERBOSE" = "yes" ] && DAEMON_ENV="RUST_LOG=debug"

	return 0
}

# The daemon may live on external storage (the package can be externalized): at
# boot that storage is mounted asynchronously, so wait for the binary in a
# background subshell instead of failing with "not found". This complements the
# deferred-service mechanism of rc.external, and covers the case where the
# service is not (yet) listed in /mod/etc/external.defer.pkg.
binary_ready() {
	[ -x /usr/bin/$DAEMON_BIN ] && return 0
	timeout=$BLE2UART_GATEWAY_CONFIG_WAIT
	while [ "$timeout" -gt 0 ]; do
		sleep 2
		timeout=$((timeout - 2))
		[ -x /usr/bin/$DAEMON_BIN ] && return 0
	done
	return 1
}

# The serial device of the module is also mounted asynchronously (USB). Wait for
# it before spawning the daemon when a fixed path is configured.
serial_ready() {
	[ -z "$BLE2UART_GATEWAY_SERIAL" ] && return 0
	[ -c "$BLE2UART_GATEWAY_SERIAL" ] && return 0
	timeout=$BLE2UART_GATEWAY_CONFIG_WAIT
	while [ "$timeout" -gt 0 ]; do
		sleep 2
		timeout=$((timeout - 2))
		[ -c "$BLE2UART_GATEWAY_SERIAL" ] && return 0
	done
	return 1
}

start() {
	[ -x "$GATEWAY_BIN" ] || return 1
	config || return 1
	SERIAL_DEVICE=$("$GATEWAY_BIN" --config "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" --get serial.port) || return 1
	[ -c "$SERIAL_DEVICE" ] || return 1
	modlib_startdaemon start-stop-daemon -S -b -m -p "$PID_FILE" \
		-x /bin/sh -- -c 'log=$1; shift; export BLE2UART_GATEWAY_LOG="$log"; exec "$@" >"$log.startup" 2>&1' \
		sh "$BLE2UART_GATEWAY_STORE/rc.$DAEMON.log" "$GATEWAY_BIN" \
		--config "$BLE2UART_GATEWAY_STORE/ble2uart_gateway.yaml" $BLE2UART_GATEWAY_EXTRA_ARGS >>"$LOG" 2>&1
}

# Terminates the daemon. modlib_stop() calls this function, therefore it must
# never call modlib_stop() again (that would recurse forever).
stop() {
	pid="$(cat $PID_FILE 2>/dev/null)"

	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		# Flush the configuration and the exposed-id state before stopping.
		kill "$pid" 2>/dev/null
		timeout=15
		while [ "$timeout" -gt 0 ] && kill -0 "$pid" 2>/dev/null; do
			sleep 1
			timeout=$((timeout - 1))
		done
		kill -9 "$pid" 2>/dev/null
	fi

	# Nothing is archived here: the store is a plain directory on a mounted
	# disk, so the YAML with the bind keys is already persistent. A store in the
	# RAM disk was a second, fragile source of truth and has been dropped.

	return 0
}

case "$1" in
	""|load)
		modreg daemon $DAEMON
		modreg cgi $DAEMON "ble2uart_gateway"
		modreg extra $DAEMON '' 2 api
		if [ "$BLE2UART_GATEWAY_ENABLED" != "yes" ] || [ -x /usr/bin/$DAEMON_BIN ]; then
			modlib_start "$BLE2UART_GATEWAY_ENABLED"
		else
			(
				. /etc/init.d/modlibrc
				[ -r /mod/etc/conf/$DAEMON.cfg ] && . /mod/etc/conf/$DAEMON.cfg
				BLE2UART_GATEWAY_CONFIG_WAIT="${BLE2UART_GATEWAY_CONFIG_WAIT:-120}"
				echo "$(date): waiting for /usr/bin/$DAEMON_BIN (external storage)"
				if binary_ready; then
					/etc/init.d/rc.$DAEMON start
				else
					echo "$(date): /usr/bin/$DAEMON_BIN not available after ${BLE2UART_GATEWAY_CONFIG_WAIT}s"
				fi
			) >>$LOG 2>&1 &
		fi
		;;
	unload)
		modunreg cgi $DAEMON
		modunreg extra $DAEMON
		modunreg daemon $DAEMON
		modlib_stop
		;;
	start)
		modlib_start || exit $?
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0
