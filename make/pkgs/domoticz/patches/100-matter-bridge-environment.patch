@@ -0,0 +1,50 @@
+#pragma once
+
+#include <algorithm>
+#include <limits>
+#include <map>
+#include <set>
+#include <vector>
+
+namespace matter_environment
+{
+inline std::map<int, int> groups(const std::map<int, std::vector<int>>& parts, const std::set<int>& aggregators)
+{
+    std::map<int, int> result;
+    for (const auto& endpoint : parts)
+    {
+        if (aggregators.empty() || endpoint.first == 0 || aggregators.count(endpoint.first))
+        {
+            result[endpoint.first] = 0;
+            continue;
+        }
+        int anchor = endpoint.first;
+        std::set<int> visited;
+        while (true)
+        {
+            if (!visited.insert(anchor).second)
+            {
+                anchor = endpoint.first;
+                break;
+            }
+            int parent = -1;
+            std::size_t smallest = std::numeric_limits<std::size_t>::max();
+            for (const auto& candidate : parts)
+            {
+                if (candidate.first == 0 || candidate.first == anchor || aggregators.count(candidate.first))
+                    continue;
+                if (candidate.second.size() < smallest && std::find(candidate.second.begin(), candidate.second.end(), anchor) != candidate.second.end())
+                {
+                    parent = candidate.first;
+                    smallest = candidate.second.size();
+                }
+            }
+            if (parent < 0)
+                break;
+            anchor = parent;
+        }
+        result[endpoint.first] = anchor;
+    }
+    return result;
+}
