# ot-daemon (the Thread stack, 1.3 MB) and ot-ctl are externalized together:
# ot-ctl talks to the daemon over its control socket, so both should be present
# in the same filesystem. The radio is an external RCP reached over UART, so
# there is no in-firmware dependency to keep.
[ "$EXTERNAL_FREETZ_PACKAGE_OPENTHREAD" == "y" ] && EXTERNAL_FILES+=" /usr/bin/ot-daemon /usr/bin/ot-ctl"
