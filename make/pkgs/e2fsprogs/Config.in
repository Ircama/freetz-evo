comment "E2fsprogs requires 'Remove e2fsprogs' patch or '-ng' suffix mode"
	depends on !FREETZ_REMOVE_AVM_E2FSPROGS

config FREETZ_PACKAGE_E2FSPROGS
	bool "E2fsprogs 1.47.4 (binary only)"
	default n
	help
		This package contains essential ext2, ext3 and ext4 filesystem
		utilities which consists of e2fsck, mke2fs, debugfs, dumpe2fs,
		tune2fs, and most of the other core ext2 filesystem utilities.
		Homepage: http://e2fsprogs.sourceforge.net/

if FREETZ_PACKAGE_E2FSPROGS

	config FREETZ_PACKAGE_E2FSPROGS_SUFFIX_NG
		bool "Install binaries with '-ng' suffix" if FREETZ_REMOVE_AVM_E2FSPROGS
		default y if !FREETZ_REMOVE_AVM_E2FSPROGS
		default n
		help
			Install selected e2fsprogs tools as <name>-ng in /usr/sbin
			to avoid conflicts with AVM-provided binaries.
			This mode is forced when "Remove e2fsprogs" patch is not active.

	comment "AVM e2fsprogs patch not active: '-ng' suffix mode is forced"
		depends on !FREETZ_REMOVE_AVM_E2FSPROGS

	config FREETZ_PACKAGE_E2FSPROGS_E2FSCK
		bool "Checking Tools"
		default n
		select FREETZ_LIB_libblkid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libe2p	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libuuid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of checking tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_E2FSCK
		bool "e2fsck"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FSCK
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_FSCK
		bool "fsck"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FSCK
		default y

	config FREETZ_PACKAGE_E2FSPROGS_E2MAKING
		bool "Making tools"
		default n
		select FREETZ_LIB_libblkid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libe2p	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libuuid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of making tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_MKE2FS
		bool "mke2fs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2MAKING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_MKLOSTFOUND
		bool "mklost+found"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2MAKING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_E2TUNING
		bool "Tuning tools"
		default n
		select FREETZ_LIB_libblkid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libe2p	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libuuid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of tuning tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_TUNE2FS
		bool "tune2fs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_DUMPE2FS
		bool "dumpe2fs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_CHATTR
		bool "chattr"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_LSATTR
		bool "lsattr"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_E2LABEL
		bool "e2label"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING && FREETZ_PACKAGE_E2FSPROGS_TOOL_TUNE2FS
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_FINDFS
		bool "findfs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2TUNING && FREETZ_PACKAGE_E2FSPROGS_TOOL_TUNE2FS
		default y

	config FREETZ_PACKAGE_E2FSPROGS_E2DEBUG
		bool "Debugging tools"
		default n
		select FREETZ_LIB_libblkid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libe2p	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libss		if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libuuid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of debug tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_E2IMAGE
		bool "e2image"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2DEBUG
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_E2UNDO
		bool "e2undo"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2DEBUG
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_DEBUGFS
		bool "debugfs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2DEBUG
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_LOGSAVE
		bool "logsave"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2DEBUG
		default y

	config FREETZ_PACKAGE_E2FSPROGS_BLKID
		bool "blkid"
		default n
		select FREETZ_LIB_libblkid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Copy blkid to image

	config FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		bool "Repair and misc. tools"
		default n
		select FREETZ_PACKAGE_E2FSPROGS_BLKID if ! FREETZ_BUSYBOX_BLKID
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libuuid	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of repair/misc tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_BADBLOCKS
		bool "badblocks"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_FILEFRAG
		bool "filefrag"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_E2FREEFRAG
		bool "e2freefrag"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_UUIDD
		bool "uuidd"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_UUIDGEN
		bool "uuidgen"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2FIXING
		default y

	config FREETZ_PACKAGE_E2FSPROGS_E2RESIZE
		bool "Resize tools"
		default n
		select FREETZ_LIB_libe2p	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libext2fs	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		select FREETZ_LIB_libcom_err	if FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
		help
			Enable selection of resize tools below.

	config FREETZ_PACKAGE_E2FSPROGS_TOOL_RESIZE2FS
		bool "resize2fs"
		depends on FREETZ_PACKAGE_E2FSPROGS_E2RESIZE
		default y

	choice
		prompt "Link"
		default FREETZ_PACKAGE_E2FSPROGS_PKG_STAT

		config FREETZ_PACKAGE_E2FSPROGS_ALL_DYN
			bool "all libraries dynamically"

		config FREETZ_PACKAGE_E2FSPROGS_PKG_STAT
			bool "e2fsprogs libraries statically"

		config FREETZ_PACKAGE_E2FSPROGS_ALL_STAT
			bool "all libraries statically"
	endchoice

endif # FREETZ_PACKAGE_E2FSPROGS
