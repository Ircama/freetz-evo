[ "$EXTERNAL_FREETZ_PACKAGE_E2FSPROGS_resize2fs"    == "y" ] && EXTERNAL_FILES+=" /usr/sbin/resize2fs${E2FSPROGS_SUFFIX}"
[ "$EXTERNAL_FREETZ_PACKAGE_E2FSPROGS_blkid"        == "y" ] && EXTERNAL_FILES+=" /usr/sbin/blkid${E2FSPROGS_SUFFIX}"
