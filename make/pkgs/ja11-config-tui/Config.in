config FREETZ_PACKAGE_JA11_CONFIG_TUI
	bool "ja11-config-tui 1.0 (binary only)"
	select FREETZ_LIB_libncurses
	select FREETZ_LIB_hidapi
	default n
	help
		TUI configurator for the FiiO JA11 (KT02H20).
		
		Communicates over HID with the KT02H20 chip inside the
		FiiO JadeAudio JA11 to configure the 5-band parametric EQ.
		
		Uses hidapi's libusb backend (like hidws), NOT hidraw:
		on startup it lists all HID devices and lets you choose which
		one to connect to.
		
		Access via SSH: ja11-config-tui
