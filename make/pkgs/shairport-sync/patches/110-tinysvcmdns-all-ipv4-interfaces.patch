+static ssize_t send_packet_on_interface(int fd, const struct sockaddr_in *ifaddr,
+                                        const struct sockaddr_in *toaddr,
+                                        const void *data, size_t len) {
+  if (setsockopt(fd, IPPROTO_IP, IP_MULTICAST_IF, (char *)&ifaddr->sin_addr,
+                 sizeof(ifaddr->sin_addr)) < 0) {
+    return -1;
+  }
+
+  return sendto(fd, data, len, 0, (const struct sockaddr *)toaddr, sizeof(*toaddr));
+}
+
 static ssize_t send_packet(int fd, const void *data, size_t len) {
   static struct sockaddr_in toaddr;
+  struct ifaddrs *ifalist = NULL;
+  struct ifaddrs *ifa = NULL;
+  ssize_t last_result = -1;
+  int sent = 0;
+
   if (toaddr.sin_family != AF_INET) {
     memset(&toaddr, 0, sizeof(struct sockaddr_in));
     toaddr.sin_family = AF_INET;
@@ -1230,6 +1283,22 @@
     toaddr.sin_addr.s_addr = inet_addr(MDNS_ADDR);
   }
 
+  if (getifaddrs(&ifalist) == 0) {
+    for (ifa = ifalist; ifa != NULL; ifa = ifa->ifa_next) {
+      if (!mdns_ipv4_interface_matches(ifa))
+        continue;
+
+      last_result = send_packet_on_interface(fd, (struct sockaddr_in *)ifa->ifa_addr,
+                                             &toaddr, data, len);
+      if (last_result >= 0)
+        sent++;
+    }
+    freeifaddrs(ifalist);
+  }
+
+  if (sent > 0)
+    return last_result;
+
   return sendto(fd, data, len, 0, (struct sockaddr *)&toaddr, sizeof(struct sockaddr_in));
 }
 
