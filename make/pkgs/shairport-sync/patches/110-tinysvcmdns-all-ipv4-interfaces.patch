+static int mdns_ipv4_interface_matches(const struct ifaddrs *ifa) {
+  if ((ifa == NULL) || (ifa->ifa_addr == NULL))
+    return 0;
+
+  if ((ifa->ifa_flags & IFF_LOOPBACK) || (ifa->ifa_addr->sa_family != AF_INET))
+    return 0;
+
+  if ((config.interface != NULL) && (strcmp(config.interface, ifa->ifa_name) != 0))
+    return 0;
+
+  return 1;
+}
+
+static int mdns_join_ipv4_memberships(int sd) {
+  struct ifaddrs *ifalist = NULL;
+  struct ifaddrs *ifa = NULL;
+  int joined = 0;
+
+  if (getifaddrs(&ifalist) < 0) {
+    log_message(LOG_ERR, "recv getifaddrs(): %m");
+    return -1;
+  }
+
+  for (ifa = ifalist; ifa != NULL; ifa = ifa->ifa_next) {
+    struct ip_mreq mreq;
+
+    if (!mdns_ipv4_interface_matches(ifa))
+      continue;
+
+    memset(&mreq, 0, sizeof(struct ip_mreq));
+    mreq.imr_interface = ((struct sockaddr_in *)ifa->ifa_addr)->sin_addr;
+    mreq.imr_multiaddr.s_addr = inet_addr(MDNS_ADDR);
+    if (setsockopt(sd, IPPROTO_IP, IP_ADD_MEMBERSHIP, (char *)&mreq, sizeof(mreq)) == 0)
+      joined++;
+  }
+
+  freeifaddrs(ifalist);
+  return joined > 0 ? 0 : -1;
+}
