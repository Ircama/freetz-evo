config FREETZ_PACKAGE_PYTHON3_ULID_TRANSFORM
	bool "ulid-transform 2.2.9"
	depends on FREETZ_PACKAGE_PYTHON3
	default n
	help
		ulid-transform 2.2.9

		Create and transform ULIDs.
		This package builds a native extension and requires Rust/Cargo
		at build time.

		WWW: https://pypi.org/project/ulid-transform/
