config FREETZ_PACKAGE_ALSAEQUAL_CGI
	bool "alsaequal CGI (equalizer config/control web UI) - DEVELOPER"
	depends on FREETZ_PACKAGE_ALSAEQUAL && FREETZ_PACKAGE_ALSA_UTILS
	depends on FREETZ_SHOW_DEVELOPER
	default y
	help
		Provides the freetz web UI pages to configure alsaequal and adjust
		the exported equalizer controls at runtime.

		Developer-only together with the underlying alsaequal package.

		http://fritz.box:81/cgi-bin/conf/alsaequal