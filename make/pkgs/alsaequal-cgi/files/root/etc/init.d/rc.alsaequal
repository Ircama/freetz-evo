#!/bin/sh

DAEMON=alsaequal
DAEMON_LONG_NAME='ALSA Equalizer'
DAEMON_CONFIG=/var/lib/alsa/conf.d/50-alsaequal.conf
. /etc/init.d/modlibrc

[ -r /mod/etc/conf/alsaequal.cfg ] && . /mod/etc/conf/alsaequal.cfg

resolve_ladspa_library() {
	local library="$1"
	local search_path old_ifs dir
	case "$library" in
		/*)
			[ -r "$library" ] && {
				printf '%s\n' "$library"
				return 0
			}
			return 1
			;;
	esac
	search_path="${LADSPA_PATH:-/usr/lib/ladspa:/usr/lib/freetz/ladspa:/mod/usr/lib/ladspa:/mod/external/usr/lib/ladspa:/usr/lib}"
	old_ifs="$IFS"
	IFS=':'
	for dir in $search_path; do
		[ -n "$dir" ] || continue
		if [ -r "$dir/$library" ]; then
			IFS="$old_ifs"
			printf '%s\n' "$dir/$library"
			return 0
		fi
	done
	IFS="$old_ifs"
	return 1
}

config() {
	local resolved_library
	mkdir -p "$(dirname "$DAEMON_CONFIG")" 2>/dev/null
	if [ "$ALSAEQUAL_ENABLED" = 'yes' ]; then
		if ! resolved_library="$(resolve_ladspa_library "$ALSAEQUAL_LIBRARY")"; then
			echo "alsaequal: LADSPA library '$ALSAEQUAL_LIBRARY' not found; generated ALSA configuration disabled." >&2
			rm -f "$DAEMON_CONFIG"
			return 0
		fi
		export ALSAEQUAL_LIBRARY="$resolved_library"
		modlib_config "$DAEMON" "$DAEMON_CONFIG"
	else
		rm -f "$DAEMON_CONFIG"
	fi
}

case "$1" in
	""|load)
		modreg cgi "$DAEMON" "$DAEMON_LONG_NAME"
		modreg status "$DAEMON" "$DAEMON_LONG_NAME"
		config
		;;
	unload)
		modunreg status "$DAEMON"
		modunreg cgi "$DAEMON"
		rm -f "$DAEMON_CONFIG"
		;;
	config|start|restart)
		config
		;;
	stop)
		: 
		;;
	status)
		if [ "$ALSAEQUAL_ENABLED" = 'yes' ] && [ -s "$DAEMON_CONFIG" ]; then
			echo 'configured'
		else
			echo 'disabled'
		fi
		;;
	*)
		echo "Usage: $0 [load|unload|config|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0