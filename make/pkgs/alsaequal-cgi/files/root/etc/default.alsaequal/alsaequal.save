#!/bin/sh

normalize_channels() {
	local value
	value="$(printf '%s' "$1" | tr -d '[:space:]')"
	[ -n "$value" ] || value=2
	printf '%s' "$value"
}

resolve_ladspa_library() {
	local library="$1"
	local search_path old_ifs dir
	case "$library" in
		/*)
			[ -r "$library" ] && {
				printf '%s\n' "$library"
				return 0
			}
			return 1
			;;
	esac
	search_path="${LADSPA_PATH:-/usr/lib/ladspa:/usr/lib/freetz/ladspa:/mod/usr/lib/ladspa:/mod/external/usr/lib/ladspa:/usr/lib}"
	old_ifs="$IFS"
	IFS=':'
	for dir in $search_path; do
		[ -n "$dir" ] || continue
		if [ -r "$dir/$library" ]; then
			IFS="$old_ifs"
			printf '%s\n' "$dir/$library"
			return 0
		fi
	done
	IFS="$old_ifs"
	return 1
}

pkg_pre_save() {
	ALSAEQUAL_CHANNELS="$(normalize_channels "$ALSAEQUAL_CHANNELS")"
	export ALSAEQUAL_CHANNELS

	case "$ALSAEQUAL_CHANNELS" in
		''|*[!0-9]*)
			echo 'Error: channels must be a positive integer.' >&2
			return 1
			;;
	esac
	[ "$ALSAEQUAL_CHANNELS" -gt 0 ] 2>/dev/null || {
		echo 'Error: channels must be greater than zero.' >&2
		return 1
	}
	if [ "$ALSAEQUAL_ENABLED" = 'yes' ] && [ -z "$ALSAEQUAL_LIBRARY" -o -z "$ALSAEQUAL_MODULE" ]; then
		echo 'Error: library and module are required when alsaequal is enabled.' >&2
		return 1
	fi
	if [ "$ALSAEQUAL_ENABLED" = 'yes' ] && ! resolve_ladspa_library "$ALSAEQUAL_LIBRARY" >/dev/null; then
		echo "Error: LADSPA library '$ALSAEQUAL_LIBRARY' was not found. Install a compatible plugin or configure an absolute library path." >&2
		return 1
	fi
	if [ "$ALSAEQUAL_SET_DEFAULT" = 'yes' ]; then
		case "$ALSAEQUAL_SLAVE_PCM" in
			default|equal|plugequal)
				echo 'Error: slave PCM must not point to default/equal/plugequal when default routing is enabled.' >&2
				return 1
				;;
		esac
	fi
	return 0
}

pkg_apply_save() {
	/etc/init.d/rc.alsaequal config >/dev/null 2>&1 || true
	return 0
}