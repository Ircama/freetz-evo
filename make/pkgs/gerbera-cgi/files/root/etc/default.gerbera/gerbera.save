#!/bin/sh

pkg_pre_save() {
	if [ "$GERBERA_ENABLED" = "yes" ] && [ -z "$GERBERA_BASEDIR" ]; then
		echo "Error: Base directory required when enabled" >&2
		return 1
	fi
	return 0
}

pkg_apply_save() {
	[ -r /mod/etc/conf/gerbera.cfg ] && . /mod/etc/conf/gerbera.cfg

	: "${GERBERA_WEBROOT:=/usr/share/gerbera/web}"

	mkdir -p "${GERBERA_BASEDIR}" 2>/dev/null

	# Generate config.xml dynamically
	local config_file="${GERBERA_BASEDIR}/config.xml"
	if HOME="${GERBERA_BASEDIR}" gerbera --create-advanced-config > "$config_file" 2>/dev/null; then
		sed -i \
		    -e "s|<name>Gerbera</name>|<name>${GERBERA_FRIENDLY_NAME:-Gerbera (Freetz)}</name>|g" \
		    -e "s|<alive>180</alive>|<alive>${GERBERA_ALIVE:-180}</alive>|g" \
		    -e "s|<directory location=\"/media\" |<directory location=\"${GERBERA_BASEDIR}/media\" |g" \
		    -e "/<scripting>/,/<\\/scripting>/ s|<enabled>yes</enabled>|<enabled>${GERBERA_SCRIPTING:-no}</enabled>|" \
		    "$config_file"
	fi

	# Restart daemon to apply config
	if [ -x /mod/etc/init.d/rc.gerbera ]; then
		/mod/etc/init.d/rc.gerbera restart 2>/dev/null || true
	elif [ -x /etc/init.d/rc.gerbera ]; then
		/etc/init.d/rc.gerbera restart 2>/dev/null || true
	fi

	return 0
}
