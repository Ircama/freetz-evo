#!/bin/sh

DAEMON=gerbera
DAEMON_BIN=gerbera
PID_FILE=/var/run/$DAEMON.pid
. /etc/init.d/modlibrc

[ -r /mod/etc/conf/gerbera.cfg ] && . /mod/etc/conf/gerbera.cfg

: "${GERBERA_ENABLED:=no}"
: "${GERBERA_BASEDIR:=/tmp/flash/gerbera}"
: "${GERBERA_PORT:=49152}"
: "${GERBERA_FRIENDLY_NAME:=Gerbera (Freetz)}"

DAEMON_ARGS="--port ${GERBERA_PORT} --home ${GERBERA_BASEDIR}"

is_running() {
	[ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null && return 0
	return 1
}

start() {
	echo "Starting ${DAEMON}..."
	if is_running; then
		echo "already running."
		return 0
	fi
	if [ ! -x "$(command -v $DAEMON_BIN)" ]; then
		echo "binary not found."
		exit 1
	fi
	mkdir -p "${GERBERA_BASEDIR}" 2>/dev/null
	start-stop-daemon -S -b -q -m -p "$PID_FILE" -x /usr/bin/$DAEMON_BIN -- $DAEMON_ARGS
	echo 'done.'
}

stop() {
	echo "Stopping ${DAEMON}..."
	if ! is_running; then
		echo "not running."
		rm -f "$PID_FILE" 2>/dev/null
		return 0
	fi
	start-stop-daemon -K -q -p "$PID_FILE" 2>/dev/null || true
	rm -f "$PID_FILE"
	echo 'done.'
}

case "$1" in
	""|load)
		modreg daemon $DAEMON
		modreg cgi 'gerbera' 'Gerbera'
		if [ "$GERBERA_ENABLED" = "yes" ]; then
			start
		fi
		;;
	unload)
		modunreg daemon $DAEMON
		modunreg cgi 'gerbera'
		stop
		;;
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0
