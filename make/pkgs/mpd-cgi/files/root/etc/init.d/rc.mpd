#!/bin/sh

DAEMON=mpd
DAEMON_BIN=mpd
DAEMON_LONG_NAME="MPD"
CONF_ENABLED=MPD_ENABLED
DAEMON_CHECK="$DAEMON_BIN"
DAEMON_CONFIG=/mod/etc/mpd.conf
PID_FILE=/var/run/mpd.pid
MPD_SOCKET=/var/run/mpd/socket
. /etc/init.d/modlibrc

[ -r /mod/etc/conf/mpd.cfg ] && . /mod/etc/conf/mpd.cfg

: ${MPD_CONFIG_DIR:=/tmp/flash/mpd}
MPD_CONFIG_DIR="${MPD_CONFIG_DIR%/}"
MPD_PLAYLIST_DIR="${MPD_CONFIG_DIR}/playlists"

config() {
	mkdir -p "$MPD_CONFIG_DIR" "$MPD_PLAYLIST_DIR" 2>/dev/null
	case "$MPD_MUSIC_DIR" in
		''|*://*) ;;
		*) mkdir -p "$MPD_MUSIC_DIR" 2>/dev/null ;;
	esac
	modlib_config "$DAEMON" "$DAEMON_CONFIG"
}

startdaemon_pre() {
	rm -f "$PID_FILE" "$MPD_SOCKET" 2>/dev/null
}

start() {
	modlib_startdaemon $DAEMON_BIN "$DAEMON_CONFIG"
}

stop_post() {
	rm -f "$MPD_SOCKET" 2>/dev/null
}

case $1 in
	""|load)
		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON
		modreg status $DAEMON "$DAEMON_LONG_NAME"

		modlib_start $MPD_ENABLED
		;;
	unload)
		modunreg status $DAEMON
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modlib_stop
		rm -f "$MPD_SOCKET" 2>/dev/null
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0