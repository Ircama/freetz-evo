#!/bin/sh

DAEMON=mpd
DAEMON_BIN=mpd
DAEMON_LONG_NAME="MPD"
CONF_ENABLED=MPD_ENABLED
DAEMON_CHECK="$DAEMON_BIN"
DAEMON_CONFIG=/mod/etc/mpd.conf
PID_FILE=/var/run/mpd.pid
MPD_SOCKET=/var/run/mpd/socket
MPD_RUNTIME_DIR=${MPD_SOCKET%/*}
DAEMON_ENV='LD_PRELOAD=libjemalloc.so.2'
. /etc/init.d/modlibrc

[ -r /mod/etc/conf/mpd.cfg ] && . /mod/etc/conf/mpd.cfg

: ${MPD_CONFIG_DIR:=/var/media/ftp/MediaServer/mpd}
MPD_CONFIG_DIR="${MPD_CONFIG_DIR%/}"
MPD_PLAYLIST_DIR="${MPD_CONFIG_DIR}/playlists"
MPD_STATE_FILE="${MPD_CONFIG_DIR}/state"
MPD_DB_FILE="${MPD_CONFIG_DIR}/database"
MPD_LOG_FILE="${MPD_CONFIG_DIR}/mpd.log"

sanitize_runtime_file_path() {
	local target_path="$1"
	[ -n "$target_path" ] || return 0
	if [ -d "$target_path" ]; then
		# Preserve wrongly-created directories and recreate the expected file path.
		local backup_path="${target_path}.dir.$(date +%Y%m%d-%H%M%S)"
		mv "$target_path" "$backup_path" 2>/dev/null || return 1
	fi
	if [ ! -e "$target_path" ]; then
		: > "$target_path" 2>/dev/null || return 1
	fi
	return 0
}

config() {
	mkdir -p "$MPD_CONFIG_DIR" "$MPD_PLAYLIST_DIR" "$MPD_RUNTIME_DIR" 2>/dev/null
	case "$MPD_MUSIC_DIR" in
		''|*://*) ;;
		*) mkdir -p "$MPD_MUSIC_DIR" 2>/dev/null ;;
	esac
	sanitize_runtime_file_path "$MPD_STATE_FILE"
	sanitize_runtime_file_path "$MPD_DB_FILE"
	sanitize_runtime_file_path "$MPD_LOG_FILE"
	modlib_config "$DAEMON" "$DAEMON_CONFIG"
}

startdaemon_pre() {
	mkdir -p "$MPD_RUNTIME_DIR" 2>/dev/null
	mkdir -p "$MPD_CONFIG_DIR" "$MPD_PLAYLIST_DIR" 2>/dev/null
	sanitize_runtime_file_path "$MPD_STATE_FILE"
	sanitize_runtime_file_path "$MPD_DB_FILE"
	sanitize_runtime_file_path "$MPD_LOG_FILE"
	rm -f "$PID_FILE" "$MPD_SOCKET" 2>/dev/null
}

start() {
	modlib_startdaemon $DAEMON_BIN "$DAEMON_CONFIG"
}

stop_post() {
	rm -f "$MPD_SOCKET" 2>/dev/null
}

case $1 in
	""|load)
		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON
		modreg status $DAEMON "$DAEMON_LONG_NAME"

		modlib_start $MPD_ENABLED
		;;
	unload)
		modunreg status $DAEMON
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modlib_stop
		rm -f "$MPD_SOCKET" 2>/dev/null
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0