#!/bin/sh

DAEMON=shairport-sync
DAEMON_BIN=shairport-sync
DAEMON_LONG_NAME="Shairport Sync"
CONF_ENABLED=SHAIRPORT_SYNC_ENABLED
DAEMON_CHECK="$DAEMON_BIN"
DAEMON_CONFIG=/mod/etc/shairport-sync.conf
PID_FILE=/var/run/shairport-sync.pid
COLLECTOR_BIN=/usr/bin/shairport-sync-status-cache
COLLECTOR_PID_FILE=/var/run/shairport-sync-status-cache.pid
METADATA_DIR=/tmp/shairport-sync
METADATA_PIPE=${METADATA_DIR}/metadata
STATUS_FILE=${METADATA_DIR}/status.env
. /etc/init.d/modlibrc

config() {
	mkdir -p "$METADATA_DIR" /var/log 2>/dev/null
	modlib_config
}

start_pre() {
	# Clear stale pid files before start.
	if [ -f "$PID_FILE" ]; then
		local pid
		pid=$(cat "$PID_FILE" 2>/dev/null)
		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PID_FILE"
		fi
	fi
	if [ -f "$COLLECTOR_PID_FILE" ]; then
		local collector_pid
		collector_pid=$(cat "$COLLECTOR_PID_FILE" 2>/dev/null)
		if [ -n "$collector_pid" ] && ! kill -0 "$collector_pid" 2>/dev/null; then
			rm -f "$COLLECTOR_PID_FILE"
		fi
	fi
	return 0
}

startdaemon_pre() {
	start-stop-daemon -K -q -p "$COLLECTOR_PID_FILE" >/dev/null 2>&1 || true
	start-stop-daemon -K -q -x "$COLLECTOR_BIN" >/dev/null 2>&1 || true
	killall shairport-sync-status-cache >/dev/null 2>&1 || true
	rm -f "$METADATA_PIPE"
	mkfifo "$METADATA_PIPE" || return 1
	start-stop-daemon -S -b -q -m -p "$COLLECTOR_PID_FILE" -n shairport-sync-status-cache \
		-a "$COLLECTOR_BIN" -- "$METADATA_PIPE" "$STATUS_FILE" || return 1
	return 0
}

start() {
	modlib_startdaemon "$DAEMON_BIN" -d -c "$DAEMON_CONFIG"
}

stop_pre() {
	# Prepare for stop: clear stale PID file if process is gone
	if [ -f "$PID_FILE" ]; then
		local pid
		pid=$(cat "$PID_FILE" 2>/dev/null)
		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PID_FILE"
		fi
	fi
	return 0
}

stop() {
	local retval=0
	local timeout=10
	
	# Try start-stop-daemon first with PID file if available
	if [ -s "$PID_FILE" ]; then
		start-stop-daemon -K -q -p "$PID_FILE" >/dev/null 2>&1 || retval=$?
	fi
	
	# Fallback to killall if still running
	if killall -0 "$DAEMON_BIN" >/dev/null 2>&1; then
		# Wait for graceful shutdown
		while [ $timeout -gt 0 ] && killall -0 "$DAEMON_BIN" >/dev/null 2>&1; do
			sleep 1
			timeout=$((timeout - 1))
		done
		
		# Force kill if still running
		if killall -0 "$DAEMON_BIN" >/dev/null 2>&1; then
			killall -9 "$DAEMON_BIN" >/dev/null 2>&1 || retval=$?
		fi
	fi
	
	return $retval
}

stop_post() {
	start-stop-daemon -K -q -p "$COLLECTOR_PID_FILE" >/dev/null 2>&1 || true
	start-stop-daemon -K -q -x "$COLLECTOR_BIN" >/dev/null 2>&1 || true
	killall shairport-sync-status-cache >/dev/null 2>&1 || true
	rm -f "$COLLECTOR_PID_FILE" "$METADATA_PIPE" "$STATUS_FILE"
}

case $1 in
	""|load)
		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON
		modreg status $DAEMON "$DAEMON_LONG_NAME"

		modlib_start $SHAIRPORT_SYNC_ENABLED
		;;
	unload)
		modunreg status $DAEMON
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modlib_stop
		start-stop-daemon -K -q -p "$COLLECTOR_PID_FILE" >/dev/null 2>&1 || true
		rm -f "$COLLECTOR_PID_FILE" "$METADATA_PIPE"
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0