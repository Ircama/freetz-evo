DAEMON=aria2c
DAEMON_BIN=aria2c
PID_FILE=/var/run/$DAEMON.pid
. /etc/init.d/modlibrc

# Load persistent configuration from modconf
[ -r /mod/etc/conf/aria2.cfg ] && . /mod/etc/conf/aria2.cfg

USERNAME=bittorrent
GROUPNAME=users

echoFailedAndExit() {
	echo 'failed.'
	[ -n "$1" ] && exit $1 || exit 1
}

# Check if daemon is already running
is_running() {
	if [ -f "$PID_FILE" ]; then
		local pid=$(cat "$PID_FILE" 2>/dev/null)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	pgrep -x aria2c >/dev/null 2>&1 && return 0
	return 1
}

# Boot monitor: keep aria2c alive for a short window after boot start.
# Runs in background - must not block boot.
boot_monitor() {
	local basedir="$1"
	local interval="${ARIA2_BOOT_MONITOR_INTERVAL:-10}"
	local duration="${ARIA2_BOOT_MONITOR_DURATION:-300}"
	local elapsed=0

	# Validate numbers (fallback to defaults)
	case "$interval" in ''|*[!0-9]*) interval="10" ;; esac
	case "$duration" in ''|*[!0-9]*) duration="300" ;; esac
	[ "$interval" -gt 0 ] 2>/dev/null || interval="10"
	[ "$duration" -gt 0 ] 2>/dev/null || duration="300"

	[ "$ARIA2_BOOT_MONITOR" = "yes" ] || return 0
	[ -n "$basedir" ] || return 0

	echo "$(date): Boot monitor enabled (${duration}s @ ${interval}s)" >> /tmp/rc.aria2.log

	while [ $elapsed -lt $duration ]; do
		sleep "$interval"
		elapsed=$((elapsed + interval))
		if is_running; then
			continue
		fi

		echo "$(date): Boot monitor: aria2c not running (t=${elapsed}s), restarting..." >> /tmp/rc.aria2.log
		if [ -s /tmp/aria2.startup.err ]; then
			echo "$(date): aria2c stderr (tail before restart):" >> /tmp/rc.aria2.log
			tail -n 50 /tmp/aria2.startup.err >> /tmp/rc.aria2.log 2>&1
		fi

		# Remove stale pid file if present
		rm -f "$PID_FILE" 2>/dev/null

		if start_aria2_daemon "$basedir"; then
			sleep 2
			if is_running; then
				echo "$(date): Boot monitor: restart successful" >> /tmp/rc.aria2.log
			else
				echo "$(date): Boot monitor: restart attempted but aria2c still not running" >> /tmp/rc.aria2.log
			fi
		else
			echo "$(date): Boot monitor: restart failed" >> /tmp/rc.aria2.log
		fi
	done

	echo "$(date): Boot monitor finished" >> /tmp/rc.aria2.log
}

# Ensure aria2.conf exists; also create required directories.
ensure_aria2_conf() {
	[ -r /etc/options.cfg ] && . /etc/options.cfg
	local basedir="${ARIA2_BASEDIR%/}"

	[ -z "$basedir" ] && return 1

	local conf_file="$basedir/aria2.conf"

	# Ensure directory structure
	mkdir -p "$basedir/downloads" 2>/dev/null
	chmod 777 "$basedir" "$basedir/downloads" 2>/dev/null

	# Create empty session file if not present
	[ -f "$basedir/aria2.session" ] || touch "$basedir/aria2.session"
	chmod 666 "$basedir/aria2.session" 2>/dev/null

	# If aria2.conf doesn't exist, generate a default one
	if [ ! -f "$conf_file" ]; then
		echo -n "(creating aria2.conf) "
		cat > "$conf_file" <<ARIA2_CONF_EOF
# aria2 configuration file - generated by rc.aria2
dir=$basedir/downloads
log=$basedir/aria2.log
log-level=${ARIA2_LOGLEVEL:-notice}
save-session=$basedir/aria2.session
save-session-interval=60
input-file=$basedir/aria2.session
enable-rpc=true
rpc-listen-all=true
rpc-listen-port=${ARIA2_RPC_PORT:-6800}
rpc-allow-origin-all=true
max-concurrent-downloads=${ARIA2_MAX_CONCURRENT:-5}
max-connection-per-server=${ARIA2_MAX_CONN_SERVER:-16}
split=${ARIA2_SPLIT:-5}
min-split-size=${ARIA2_MIN_SPLIT_SIZE:-20M}
continue=true
file-allocation=none
ARIA2_CONF_EOF
		chmod 600 "$conf_file" 2>/dev/null
	fi

	chown $USERNAME:$GROUPNAME "$conf_file" "$basedir/aria2.session" 2>/dev/null
	return 0
}

# Wait for time synchronization
wait_for_time_sync() {
	local max_wait="${1:-120}"
	local min_valid_year=2025
	local elapsed=0

	while [ $elapsed -lt $max_wait ]; do
		local current_year=$(date +%Y)
		if [ "$current_year" -ge $min_valid_year ]; then
			return 0
		fi
		sleep 2
		elapsed=$((elapsed + 2))
	done

	return 1
}

# Wait for base directory
wait_for_basedir() {
	local basedir="$1"
	local max_wait="${2:-120}"
	local elapsed=0

	while [ $elapsed -lt $max_wait ]; do
		if [ -d "$basedir" ]; then
			return 0
		fi
		sleep 2
		elapsed=$((elapsed + 2))
	done

	return 1
}

# Start aria2c daemon (core logic)
start_aria2_daemon() {
	local basedir="$1"
	local conf_file="$basedir/aria2.conf"
	local out_log="/tmp/aria2.startup.out"
	local err_log="/tmp/aria2.startup.err"

	# Clean up stale pid file before starting
	if [ -f "$PID_FILE" ] && ! is_running; then
		rm -f "$PID_FILE" 2>/dev/null
	fi

	# Ensure config file and directories exist
	ensure_aria2_conf || return 1

	# Backward-compat cleanup: older saves may contain an explicit empty
	# rpc-secret= line, which newer aria2 rejects as a parse error.
	if grep -q '^rpc-secret=[[:space:]]*$' "$conf_file" 2>/dev/null; then
		sed -i '/^rpc-secret=[[:space:]]*$/d' "$conf_file" 2>/dev/null
	fi

	touch /tmp/rc.aria2.log
	chmod a+rw /tmp/rc.aria2.log

	echo "$(date): About to start aria2c with config: $conf_file" >> /tmp/rc.aria2.log
	ls -l "$conf_file" >> /tmp/rc.aria2.log 2>&1

	# Capture aria2c startup output
	touch "$out_log" "$err_log" 2>/dev/null
	chmod a+rw "$out_log" "$err_log" 2>/dev/null

	# Start aria2c; it does not fork itself, so we use -b to background it.
	start-stop-daemon -S -b -m -p "$PID_FILE" \
		-N "${ARIA2_NICE:-10}" \
		-v \
		-O /tmp/rc.aria2.log \
		-c "$USERNAME:$GROUPNAME" \
		-- /bin/sh -c "exec /usr/bin/aria2c --conf-path=\"$conf_file\" >\"$out_log\" 2>\"$err_log\""

	return $?
}

# Start asynchronously (for boot/load)
start_async() {
	local basedir="$1"
	local wait_time="${2:-120}"

	echo "$(date): Starting aria2c asynchronously..." >> /tmp/rc.aria2.log

	# Wait for time sync
	if ! wait_for_time_sync "$wait_time"; then
		echo "$(date): Failed - time not synchronized after $wait_time seconds" >> /tmp/rc.aria2.log
		return 1
	fi
	echo "$(date): Time synchronized ($(date))" >> /tmp/rc.aria2.log

	# Wait for directory
	if ! wait_for_basedir "$basedir" "$wait_time"; then
		echo "$(date): Failed - directory '$basedir' not accessible after $wait_time seconds" >> /tmp/rc.aria2.log
		return 1
	fi
	echo "$(date): Directory '$basedir' is accessible" >> /tmp/rc.aria2.log

	# Start daemon
	if start_aria2_daemon "$basedir"; then
		sleep 2
		if is_running; then
			echo "$(date): aria2c started successfully" >> /tmp/rc.aria2.log
		else
			echo "$(date): aria2c is not running after 2s" >> /tmp/rc.aria2.log
			if [ -s /tmp/aria2.startup.err ]; then
				echo "$(date): aria2c stderr (tail):" >> /tmp/rc.aria2.log
				tail -n 30 /tmp/aria2.startup.err >> /tmp/rc.aria2.log 2>&1
			fi
		fi
		# Monitor stability for a short window if enabled
		boot_monitor "$basedir"
	else
		echo "$(date): Failed to start aria2c daemon" >> /tmp/rc.aria2.log
		return 1
	fi
}

start() {
	echo 'Starting aria2c daemon ...'

	if is_running; then
		echo 'failed: aria2c is already running.'
		echo "Use 'restart' to restart it."
		exit 1
	fi

	[ -r /etc/options.cfg ] && . /etc/options.cfg

	basedir="${ARIA2_BASEDIR%/}"

	# Add user and group first
	modlib_add_user_and_group $USERNAME $GROUPNAME

	if [ -z "$basedir" ]; then
		echo 'failed: No base directory configured.'
		echo "Please configure the base directory in the web interface first."
		exit 1
	fi

	# Check time sync immediately (no wait for manual start)
	echo -n " - Checking time sync ... "
	local current_year=$(date +%Y)
	if [ "$current_year" -lt 2025 ]; then
		echo 'failed.'
		echo "   Error: System time not synchronized."
		echo "   Current time: $(date)"
		exit 1
	fi
	echo 'done.'

	# Check directory immediately (no wait for manual start)
	echo -n " - Checking base directory ... "
	if [ ! -d "$basedir" ]; then
		echo 'failed.'
		echo "   Error: Base directory '$basedir' does not exist."
		exit 1
	fi
	echo 'done.'

	# Start daemon
	echo -n " - Starting daemon ... "
	if start_aria2_daemon "$basedir"; then
		sleep 3
		if is_running; then
			echo 'done.'
		else
			echo 'FAILED (process exited immediately).'
			echo ""
			echo "--- /tmp/aria2.startup.err ---"
			cat /tmp/aria2.startup.err 2>/dev/null || echo "(empty)"
			echo "--- /tmp/aria2.startup.out ---"
			cat /tmp/aria2.startup.out 2>/dev/null || echo "(empty)"
			echo "--- /tmp/rc.aria2.log (last 20 lines) ---"
			tail -n 20 /tmp/rc.aria2.log 2>/dev/null || echo "(empty)"
			exit 1
		fi
	else
		echo 'failed.'
		exit 1
	fi
}

stop() {
	echo -n 'Stopping aria2c daemon ... '

	if ! is_running; then
		echo 'not running.'
		rm -f "$PID_FILE" 2>/dev/null
		return 0
	fi

	echo ''  # newline
	echo -n ' - Terminating process ... '
	start-stop-daemon -K -p "$PID_FILE" -s TERM -R 10 || true

	# Clean up PID file
	rm -f "$PID_FILE" 2>/dev/null

	echo 'done.'
}

# Override modlibrc's stop_post to avoid spurious "failed" message
stop_post() {
	return 0
}

case $1 in
	""|load)
		modlib_add_user_and_group $USERNAME $GROUPNAME
		modreg cgi 'aria2' 'aria2'
		modreg daemon --package aria2 --rc-script rc.aria2 $DAEMON

		if [ "$ARIA2_ENABLED" = "yes" ]; then
			[ -r /etc/options.cfg ] && . /etc/options.cfg
			basedir="${ARIA2_BASEDIR%/}"
			wait_time="${ARIA2_CONFIG_WAIT:-120}"

			if [ -n "$basedir" ]; then
				if [ "$wait_time" = "0" ]; then
					# Synchronous start (no wait)
					echo "aria2c starting synchronously..."
					modlib_add_user_and_group $USERNAME $GROUPNAME
					if start_aria2_daemon "$basedir"; then
						echo "aria2c started."
						# Never block boot: monitor in background
						(
							. /etc/init.d/modlibrc
							[ -r /mod/etc/conf/aria2.cfg ] && . /mod/etc/conf/aria2.cfg
							boot_monitor "$basedir"
						) >/dev/null 2>&1 &
					else
						echo "aria2c failed to start."
					fi
				else
					# Asynchronous start (with wait for resources)
					echo "aria2c will start in background (waiting for resources)."
					(
						. /etc/init.d/modlibrc
						[ -r /mod/etc/conf/aria2.cfg ] && . /mod/etc/conf/aria2.cfg
						start_async "$basedir" "$wait_time"
					) >/dev/null 2>&1 &
				fi
			else
				echo "aria2c: base directory not configured, skipped."
			fi
		elif [ "$ARIA2_ENABLED" = "no" ]; then
			echo "aria2c is disabled."
		fi
		;;
	unload)
		modunreg daemon $DAEMON
		modunreg cgi 'aria2'
		modlib_stop
		;;
	start)
		modlib_start
		;;
	stop)
		stop
		;;
	restart)
		modlib_restart
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0
