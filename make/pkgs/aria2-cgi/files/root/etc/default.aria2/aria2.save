# This file is sourced by /usr/lib/mww/page.d/conf/save_body.sh

pkg_pre_save() {
	# Validation only - framework saves config AFTER this hook.
	# Do NOT read POST data here (already consumed by framework).
	# Do NOT update runtime files here (config not saved yet).
	:
}

# Write aria2.conf from saved variables.
# Called with BASEDIR already set.
_write_aria2_conf() {
	local basedir="$1"
	local conf_file="$basedir/aria2.conf"
	local session_file="$basedir/aria2.session"
	local dl_dir="$basedir/downloads"
	local log_file="$basedir/aria2.log"

	# Build conf file from saved variables
	local rpc_enabled="false"
	[ "$ARIA2_RPC_ENABLED" = "yes" ] && rpc_enabled="true"

	local rpc_listen_all="false"
	[ "$ARIA2_RPC_LISTEN_ALL" = "yes" ] && rpc_listen_all="true"

	local dht_enabled="false"
	[ "$ARIA2_DHT_ENABLED" = "yes" ] && dht_enabled="true"

	local async_dns="false"
	[ "$ARIA2_ASYNCDNS" = "yes" ] && async_dns="true"

	local bt_enabled="false"
	[ "$ARIA2_BT_ENABLED" = "yes" ] && bt_enabled="true"

	# aria2 treats an explicit empty 'rpc-secret=' as invalid. Omit the option
	# entirely when the token is empty or whitespace-only.
	local rpc_secret
	rpc_secret="$(echo "${ARIA2_RPC_SECRET:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
	local rpc_secret_line=""
	[ -n "$rpc_secret" ] && rpc_secret_line="rpc-secret=$rpc_secret"

	cat > "$conf_file" <<ARIA2_CONF_EOF
# aria2 configuration file
# Generated by aria2.save - DO NOT EDIT MANUALLY (will be overwritten)
# Use the web interface at http://fritz.box:81/cgi-bin/aria2 to change settings

# Directories and session
dir=$dl_dir
log=$log_file
log-level=${ARIA2_LOGLEVEL:-notice}
save-session=$session_file
save-session-interval=60
input-file=$session_file
force-save=false

# RPC / JSON-RPC interface
enable-rpc=$rpc_enabled
rpc-listen-all=$rpc_listen_all
rpc-listen-port=${ARIA2_RPC_PORT:-6800}
$rpc_secret_line
rpc-allow-origin-all=true

# Download limits
max-concurrent-downloads=${ARIA2_MAX_CONCURRENT:-5}
max-connection-per-server=${ARIA2_MAX_CONN_SERVER:-16}
split=${ARIA2_SPLIT:-5}
min-split-size=${ARIA2_MIN_SPLIT_SIZE:-20M}
max-overall-download-limit=${ARIA2_MAX_DL_LIMIT:-0}
max-overall-upload-limit=${ARIA2_MAX_UL_LIMIT:-0}

# Download behaviour
continue=true
file-allocation=none
check-integrity=true
always-resume=true
auto-file-renaming=true

# DNS
enable-async-dns=$async_dns

# BitTorrent
bt-enable-lpd=$bt_enabled
enable-dht=$dht_enabled
dht-listen-port=${ARIA2_DHT_PORT:-6881}
bt-max-peers=${ARIA2_BT_MAX_PEERS:-55}
seed-ratio=${ARIA2_SEED_RATIO:-1.0}
seed-time=${ARIA2_SEED_TIME:-0}
bt-min-crypto-level=arc4
bt-require-crypto=false
ARIA2_CONF_EOF

	chmod 600 "$conf_file" 2>/dev/null
}

pkg_apply_save() {
	# Framework has NOW saved /mod/etc/conf/aria2.cfg - re-source it
	[ -r /mod/etc/conf/aria2.cfg ] && . /mod/etc/conf/aria2.cfg

	local basedir="${ARIA2_BASEDIR%/}"
	[ -z "$basedir" ] && return 0

	# Ensure required directories exist
	mkdir -p "$basedir/downloads" "$basedir" 2>/dev/null

	# Create empty session file if not present
	[ -f "$basedir/aria2.session" ] || touch "$basedir/aria2.session"

	# Write aria2.conf with new values
	_write_aria2_conf "$basedir"
}
