config FREETZ_PACKAGE_ARIA2_CGI
	bool "aria2 CGI (freetz configuration web page)"
	depends on FREETZ_PACKAGE_ARIA2
	select FREETZ_BUSYBOX_START_STOP_DAEMON
	help
		Provides a freetz web configuration page for aria2 daemon.

		Includes init script, default config and CGI script for managing
		aria2 settings via the freetz web UI (http://fritz.box:81/).
