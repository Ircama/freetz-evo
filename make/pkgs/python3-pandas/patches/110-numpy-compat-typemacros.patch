--- pandas/meson.build.orig
+++ pandas/meson.build
@@ -31,6 +31,19 @@
     language: 'cpp',
 )
 
+# pandas 3.x Cython-generated code uses NumPy C API functions that were
+# added in NumPy 2.5.0 (PyDataType_TYPEOBJ/KIND/TYPE/BYTEORDER/TYPENUM,
+# _PyDatetimeScalarObject_GetMetadata) or are missing from some builds
+# (_PyUFuncObject_GET_ITEM_DATA). Provide compatibility macros for older
+# numpy versions.
+add_project_arguments(
+    '-DPyDataType_TYPEOBJ(descr)=((descr)->typeobj)',
+    '-DPyDataType_KIND(descr)=((descr)->kind)',
+    '-DPyDataType_TYPE(descr)=((descr)->type)',
+    '-DPyDataType_BYTEORDER(descr)=((descr)->byteorder)',
+    '-DPyDataType_TYPENUM(descr)=((descr)->type_num)',
+    '-D_PyUFuncObject_GET_ITEM_DATA(ufunc)=(ufunc)',
+    '-D_PyDatetimeScalarObject_GetMetadata(obj)=(((PyDatetimeScalarObject *)(obj))->obmeta)',
+    language: 'c',
+)
+
 cc = meson.get_compiler('c')
 if cc.get_id() == 'msvc'
     # Tracking issue: https://github.com/pandas-dev/pandas/issues/63701
