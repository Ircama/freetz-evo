menuconfig FREETZ_PACKAGE_ARIA2
	bool "aria2 1.37.0/AriaNg 1.3.13 (HTTP(s)/(s)FTP/Torrent/Metalink downloader)"
	default n
	select FREETZ_LIB_libcares    if !FREETZ_PACKAGE_ARIA2_STATIC && !FREETZ_PACKAGE_ARIA2_WITHOUT_ASYNC_DNS
	select FREETZ_LIB_libz        if !FREETZ_PACKAGE_ARIA2_STATIC
	select FREETZ_LIB_libpthread  if !FREETZ_PACKAGE_ARIA2_STATIC && FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libm        if !FREETZ_PACKAGE_ARIA2_STATIC && FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	help
		aria2 is a utility for downloading files. The supported protocols are
		HTTP(S), FTP, SFTP, BitTorrent and Metalink. aria2 can download a file
		from multiple sources/protocols and tries to utilize your maximum download
		bandwidth. It supports only a single file per request, but you can specify
		multiple URLs (even different hosts) for it. It can retrieve multiple files
		if you specify multiple files as the part of the command line. It can be
		controlled via built-in JSON-RPC and XML-RPC interface.

if FREETZ_PACKAGE_ARIA2

	config FREETZ_PACKAGE_ARIA2_WITH_OPENSSL
		bool "Use OpenSSL"
		default y
		select FREETZ_LIB_libcrypto  if !FREETZ_PACKAGE_ARIA2_STATIC
		select FREETZ_LIB_libssl     if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Build aria2 with OpenSSL support for SSL/TLS.

	config FREETZ_PACKAGE_ARIA2_WITH_GNUTLS
		bool "Use GnuTLS"
		default n
		depends on !FREETZ_PACKAGE_ARIA2_WITH_OPENSSL
		select FREETZ_LIB_libgnutls  if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Build aria2 with GnuTLS support for SSL/TLS.
			Cannot be used together with OpenSSL.

	config FREETZ_PACKAGE_ARIA2_WITH_BITTORRENT
		bool "Enable BitTorrent support"
		default y
		select FREETZ_LIB_libnettle  if !FREETZ_PACKAGE_ARIA2_STATIC && FREETZ_PACKAGE_ARIA2_WITH_BITTORRENT
		select FREETZ_LIB_libgmp     if !FREETZ_PACKAGE_ARIA2_STATIC && FREETZ_PACKAGE_ARIA2_WITH_BITTORRENT
		help
			Enable BitTorrent protocol support.

	config FREETZ_PACKAGE_ARIA2_WITH_METALINK
		bool "Enable Metalink support"
		default y
		help
			Enable Metalink support for downloading from multiple sources.

	config FREETZ_PACKAGE_ARIA2_WITH_XMLRPC
		bool "Enable XML-RPC support"
		default y
		select FREETZ_LIB_libxml2    if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Enable XML-RPC interface support.

	config FREETZ_PACKAGE_ARIA2_WITH_WEBSOCKET
		bool "Enable WebSocket support"
		default y
		help
			Enable WebSocket support for JSON-RPC interface.

	config FREETZ_PACKAGE_ARIA2_WITH_LIBSSH2
		bool "Enable SFTP/SCP support"
		default y
		select FREETZ_LIB_libssh2    if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Enable SFTP and SCP protocol support via libssh2.

	config FREETZ_PACKAGE_ARIA2_WITH_SQLITE3
		bool "Enable cookie support (Firefox3/Chromium)"
		default n
		select FREETZ_LIB_libsqlite3 if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Enable loading cookies from Firefox3/Chromium.

	config FREETZ_PACKAGE_ARIA2_WITHOUT_ASYNC_DNS
		bool "Disable async DNS (libcares)"
		default y
		help
			Disable libcares async DNS support.
			Useful if libcares is not available. Uses standard DNS resolver instead.

	config FREETZ_PACKAGE_ARIA2_STATIC
		bool "Link statically"
		default n
		help
			Build aria2 with statically linked libraries.

	config FREETZ_PACKAGE_ARIA2_CA_BUNDLE
		string "Path to CA bundle for HTTPS certificate verification"
		default "/etc/ssl/certs/ca-bundle.crt"
		depends on FREETZ_PACKAGE_ARIA2_WITH_OPENSSL || FREETZ_PACKAGE_ARIA2_WITH_GNUTLS
		help
			Path to the CA bundle file for verifying HTTPS certificates.
			Default is /etc/ssl/certs/ca-bundle.crt (standard on most Linux distributions).
			Can be overridden at runtime with --ca-certificate aria2 option.

	config FREETZ_PACKAGE_ARIA2_WITH_LIBARIA2
		bool "Build libaria2 C++ library"
		default n
		select FREETZ_LIB_libstdcpp  if !FREETZ_PACKAGE_ARIA2_STATIC
		help
			Build libaria2 C++ library for embedding aria2 in other applications.
			This provides the C++ API interface to aria2 functionality.
			Include file: <aria2/aria2.h>
			Link with: -laria2

	config FREETZ_PACKAGE_ARIA2_CGI
		bool "aria2 CGI (freetz configuration web page)"
		select FREETZ_BUSYBOX_START_STOP_DAEMON
		default y
		help
			Provides a freetz web configuration page for aria2 daemon.

			Includes init script, default config and CGI script for managing
			aria2 settings via the freetz web UI (http://fritz.box:81/).

	config FREETZ_PACKAGE_ARIANG
		bool "AriaNg 1.3.13 (Web frontend for aria2)"
		default y
		help
			AriaNg is a modern web interface for aria2. It's a pure frontend application,
			communicating with aria2 daemon via JSON-RPC interface.

			Features:
			- Modern and responsive web UI
			- Real-time task monitoring
			- Support for multiple aria2 instances
			- Download management (add, pause, resume, delete)
			- Settings configuration

			Accessed via: http://fritz.box:81/ariang/

endif # FREETZ_PACKAGE_ARIA2
