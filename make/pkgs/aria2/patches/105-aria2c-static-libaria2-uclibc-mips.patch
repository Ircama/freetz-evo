--- src/Makefile.am
+++ src/Makefile.am
@@ -746,5 +746,14 @@ LDADD = libaria2.la
 if ENABLE_LIBARIA2
 libaria2_la_LIBADD = $(EXTLDADD)
+# Link aria2c directly against the static archive (.a) instead of via libaria2.la (.so).
+# On uClibc/MIPS, __pagesize is 0 during _dl_run_init_array (the DSO constructor phase,
+# before __libc_start_main runs).  Any malloc() from libaria2's global C++ constructors
+# (e.g. aria2::PrefFactory::makePref called from _GLOBAL__sub_I_A2STR.cc) triggers a
+# divide-by-zero SIGFPE inside malloc's sYSMALLOc().  By using the .a archive here,
+# those constructors are placed in aria2c's own INIT_ARRAY and run after __libc_start_main
+# has initialised the uClibc heap (set __pagesize), avoiding the crash entirely.
+# NOTE: aria2c_LDADD overrides the global LDADD for this target only; libaria2.la is still
+# built and installed as a shared library for external consumers.
+aria2c_LDADD = .libs/libaria2.a $(EXTLDADD)
 else # !ENABLE_LIBARIA2
 LDADD += $(EXTLDADD)
 endif # !ENABLE_LIBARIA2
--- src/Makefile.in
+++ src/Makefile.in
@@ -2019,4 +2019,4 @@ LDADD = libaria2.la $(am__append_46)
 @ENABLE_LIBARIA2_TRUE@libaria2_la_LIBADD = $(EXTLDADD)
-@ENABLE_LIBARIA2_TRUE@aria2c_LDFLAGS = -static
+@ENABLE_LIBARIA2_TRUE@aria2c_LDADD = $(builddir)/.libs/libaria2.a $(EXTLDADD)
 AM_CFLAGS = @EXTRACFLAGS@
 AM_CXXFLAGS = @WARNCXXFLAGS@ @CXX1XCXXFLAGS@ @EXTRACXXFLAGS@
