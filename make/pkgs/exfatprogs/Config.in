config FREETZ_PACKAGE_EXFATPROGS
	bool "exfatprogs 1.3.2 (binary only)"
	default n
	help
		exFAT userspace tools for create/check/label operations.
		
		Provides mkfs.exfat, fsck.exfat, exfatlabel and tune.exfat.

if FREETZ_PACKAGE_EXFATPROGS

	config FREETZ_PACKAGE_EXFATPROGS_mkfs_exfat
		bool "mkfs.exfat"
		default y
		help
			Create an exFAT filesystem.

	config FREETZ_PACKAGE_EXFATPROGS_fsck_exfat
		bool "fsck.exfat"
		default y
		help
			Check and repair an exFAT filesystem.

	config FREETZ_PACKAGE_EXFATPROGS_exfatlabel
		bool "exfatlabel"
		default y
		help
			Set or read exFAT filesystem labels.

	config FREETZ_PACKAGE_EXFATPROGS_tune_exfat
		bool "tune.exfat"
		default n
		help
			Tune exFAT parameters and labels.

endif # FREETZ_PACKAGE_EXFATPROGS
