[ "$EXTERNAL_FREETZ_PACKAGE_RTORRENT_DAEMON" == "y" ] && EXTERNAL_FILES+=" /usr/bin/rtorrent"

# Include libtorrent library when daemon is enabled and not static
if [ "$EXTERNAL_FREETZ_PACKAGE_RTORRENT_DAEMON" == "y" ] && [ "$FREETZ_PACKAGE_RTORRENT_STATIC" != "y" ]; then
	EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libtorrent.so.36.0.0"
fi

# Note: libxmlrpc libraries are handled by make/libs/xmlrpc/external.files
