config FREETZ_PACKAGE_GO_LIBRESPOT
	bool "go-librespot 0.7.1 (binary only)"
	depends on FREETZ_TARGET_GCC_4_7_MIN
	select FREETZ_LIB_libasound
	select FREETZ_LIB_libFLAC
	select FREETZ_LIB_libogg
	select FREETZ_LIB_libvorbis
	select FREETZ_LIB_libvorbisenc
	select FREETZ_MODULE_snd_usb_audio if FREETZ_MODULES_AUDIO_AVAILABLE
	default n
	help
		go-librespot is a Spotify Connect audio daemon.

		This package cross-compiles the upstream Go daemon sources with
		CGO and installs the go-librespot executable on the target.

		Requires GCC 4.7 or newer: Go's cgo runtime (gcc_libinit.c)
		uses the C11 atomic builtins (__atomic_load_n, __atomic_store_n,
		__ATOMIC_*), which the old GCC 4.6.4 toolchain does not provide.

		Can be externalized to save flash memory.

if FREETZ_PACKAGE_GO_LIBRESPOT

config FREETZ_PACKAGE_GO_LIBRESPOT_CGI
	bool "go-librespot CGI (Spotify Connect config/status web UI)"
	default y
	help
		Provides the freetz CGI configuration page and live status page for
		go-librespot.
		This is the same symbol shown in "Packages -> Web interfaces".

endif