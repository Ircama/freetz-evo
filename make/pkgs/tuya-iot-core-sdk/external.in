config EXTERNAL_FREETZ_PACKAGE_TUYA_IOT_CORE_SDK
	depends on EXTERNAL_ENABLED && FREETZ_PACKAGE_TUYA_IOT_CORE_SDK
	bool "tuya-iot-core-sdk"
	default n
	help
		Externals the following file(s):
		 /usr/bin/custom_protocol_basic_demo
		 /usr/bin/data_model_basic_demo
		 /usr/bin/ota_basic_demo
		 /usr/bin/subdevice_basic_demo
