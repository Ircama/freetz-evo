diff -ruN orig/include/tuya_demo_creds.h mod/include/tuya_demo_creds.h
--- include/tuya_demo_creds.h	1970-01-01 01:00:00.000000000 +0100
+++ include/tuya_demo_creds.h	2026-10-10 16:31:13.083104018 +0200
@@ -0,0 +1,18 @@
+/*
+ * Freetz: the demos below ship hardcoded example credentials. This helper lets
+ * a shipped binary be pointed at a real device at runtime instead, by setting
+ * TUYA_PRODUCT_ID / TUYA_DEVICE_ID / TUYA_DEVICE_SECRET (and optionally
+ * TUYA_MQTT_HOST) in the environment.
+ */
+#ifndef TUYA_DEMO_CREDS_H
+#define TUYA_DEMO_CREDS_H
+
+#include <stdlib.h>
+
+static const char *tuya_demo_env(const char *key, const char *fallback)
+{
+    const char *value = getenv(key);
+    return (value && *value) ? value : fallback;
+}
+
+#endif /* TUYA_DEMO_CREDS_H */
