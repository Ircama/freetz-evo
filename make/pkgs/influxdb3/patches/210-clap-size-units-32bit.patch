+        assert!(parse_unit_suffix("1.5gb").unwrap().is_err());
+        assert!(parse_unit_suffix("gb").unwrap().is_err());
+        assert!(parse_unit_suffix("1xb").unwrap().is_err());
+        assert!(parse_unit_suffix("100").is_none());
+        assert_eq!(unit_suffixes(), "b, kb, mb, gb, tb");
+    }
