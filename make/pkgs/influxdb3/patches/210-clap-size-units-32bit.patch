+    use super::*;
+
+    #[test]
+    fn terabyte_multiplier_is_exact_on_every_pointer_width() {
+        assert_eq!(TB, 1_099_511_627_776);
+        assert_eq!(parse_unit_suffix("1tb").unwrap(), usize::try_from(TB)
+            .map_err(|_| "'1tb' overflows the maximum representable size in bytes".to_string()));
+    }
+
+    #[test]
+    fn sizes_are_checked_against_the_pointer_width() {
+        assert_eq!(parse_unit_suffix(&format!("{}b", usize::MAX)).unwrap().unwrap(), usize::MAX);
+        assert!(parse_unit_suffix(&format!("{}b", u128::from(usize::MAX as u64) + 1)).unwrap().is_err());
+        assert_eq!(parse_unit_suffix("1gb").unwrap().unwrap(), GB);
+        assert_eq!(parse_unit_suffix("0tb").unwrap().unwrap(), 0);
+        assert!(parse_unit_suffix("18446744073709551615tb").unwrap().is_err());
+    }
+
+    #[test]
+    fn suffix_rules_and_invalid_values_are_preserved() {
+        assert_eq!(parse_unit_suffix("5 mb").unwrap().unwrap(), 5 * MB);
