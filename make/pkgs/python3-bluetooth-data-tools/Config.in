config FREETZ_PACKAGE_PYTHON3_BLUETOOTH_DATA_TOOLS
	bool "bluetooth-data-tools 1.29.18 (pure python, prerequisite)"
	depends on FREETZ_PACKAGE_PYTHON3
	depends on FREETZ_TARGET_UCLIBC_1_0_58
	select FREETZ_PACKAGE_PYTHON3_CRYPTOGRAPHY
	default n
	help
		Tools for converting bluetooth data and packets.
		Provides BLE advertisement parsing, address utilities,
		distance estimation and monotonic time.
