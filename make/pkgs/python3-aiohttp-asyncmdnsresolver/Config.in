config FREETZ_PACKAGE_PYTHON3_AIOHTTP_ASYNCMDNSRESOLVER
	bool "aiohttp-asyncmdnsresolver 0.1.1"
	depends on FREETZ_PACKAGE_PYTHON3
	select FREETZ_PACKAGE_PYTHON3_AIOHTTP
	select FREETZ_PACKAGE_PYTHON3_AIODNS
	select FREETZ_PACKAGE_PYTHON3_ZEROCONF
	default n
	help
		Async MDNS resolver plugin for aiohttp.
