config FREETZ_PACKAGE_ALSAEQUAL
	bool "alsaequal 0.7.1 - DEVELOPER"
	depends on FREETZ_SHOW_DEVELOPER
	select FREETZ_LIB_libasound
	select FREETZ_LIB_caps
	default n
	help
		alsaequal exposes a LADSPA-based equalizer as ALSA PCM and control
		devices, so it can be configured with regular ALSA mixer tools.

		Note: on FRITZ!Box targets this package can require too much CPU for
		reliable normal use, so it remains developer-only.

		Freetz-EVO selects the CAPS LADSPA library by default so the bundled
		Eq10 module is immediately available. Another compatible LADSPA
		plugin can still be configured at runtime if desired.