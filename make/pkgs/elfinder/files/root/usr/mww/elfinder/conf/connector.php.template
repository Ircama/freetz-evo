// ---------------------------------------------------------------------------
// Access control callback
// Hides and locks files/folders whose name starts with '.' (except root).
// ---------------------------------------------------------------------------
function access($attr, $path, $data, $volume, $isDir, $relpath) {
    $basename = basename($path);
    return $basename[0] === '.'
        && strlen($relpath) !== 1
        ? !($attr == 'read' || $attr == 'write')
        :  null;
}

