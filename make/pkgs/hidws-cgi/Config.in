config FREETZ_PACKAGE_HIDWS_CGI
	bool "hidws CGI (freetz configuration web page)"
	depends on FREETZ_PACKAGE_HIDWS
	select FREETZ_BUSYBOX_START_STOP_DAEMON
	help
		Provides the freetz CGI configuration page and execution log for
		the hidws WebSocket <-> USB HID gateway daemon.

		Includes the init script (rc.hidws), the default configuration and
		the CGI script for managing hidws via the freetz web UI, plus links
		to the supported web apps (fiiocontrol, kt02h20-control,
		Audiocular-Aura, fiiocontrol-oss, webhid-explorer) that connect to
		the daemon over WebSocket.

		http://fritz.box:81/cgi-bin/conf/hidws
