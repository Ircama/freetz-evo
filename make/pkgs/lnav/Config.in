config FREETZ_PACKAGE_LNAV
	bool "lnav 0.14.0"
	select FREETZ_LIB_libatomic if FREETZ_TARGET_ARCH_MIPS && FREETZ_TARGET_GCC_4_8_MIN
	select FREETZ_LIB_libarchive
	default n
	help
		Advanced log file viewer and analyzer for the terminal.
		This is the native C/C++ lnav package for the target system.

if FREETZ_PACKAGE_LNAV

config FREETZ_PACKAGE_LNAV_WITH_CARGO
	bool "Build optional Rust extensions (PRQL support)"
	default n
	help
		Enable the bundled Rust/Cargo extension library used by upstream
		lnav for PRQL-related functionality.

		This keeps the default package lean, but allows the Rust-backed
		feature set to be built when the Rust host toolchain is available.

endif