+        size_t hdr_count = sizeof(*header) / sizeof(uint16_t);
+        for (size_t h = 0; h < hdr_count; h++) {
+            hdr_fields[h] = read_le16((const char*)&hdr_fields[h]);
+        }
+        swapped = 1;
+    }
 
