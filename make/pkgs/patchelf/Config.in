config FREETZ_PACKAGE_PATCHELF
	bool "PatchELF 0.19.1 (binary only)"
	depends on FREETZ_TARGET_GCC_13_MIN  # in fact min gcc11 for C++17
	depends on FREETZ_TARGET_ARCH_LE  # BE is broken
	select FREETZ_STDCXXLIB_FORCE_GNULIBSTDCXX
	select FREETZ_LIB_STDCXXLIB
	select FREETZ_LIB_libjemalloc
	default n
	help
		Modifies existing ELF executables and libraries. Can change the interpreter,
		RPATH, and other ELF metadata.
		
		Useful for modifying binaries to use different dynamic linker paths or
		library search paths (RPATH/RUNPATH).
		
		Links against jemalloc to avoid segfault on uClibc MIPS targets.

