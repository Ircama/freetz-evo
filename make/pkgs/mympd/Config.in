config FREETZ_PACKAGE_MYMPD
	bool "myMPD 25.0.2"
	select FREETZ_LIB_libcrypto
	select FREETZ_LIB_libssl
	select FREETZ_LIB_libpcre2
	select FREETZ_LIB_libpthread  if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libm        if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	default n
	help
		myMPD is a standalone and lightweight web-based MPD client.

		This freetz build uses embedded web assets and embedded
		libmpdclient to keep the package self-contained.

		Can be externalized to save flash memory.

if FREETZ_PACKAGE_MYMPD

config FREETZ_PACKAGE_MYMPD_CGI
	bool "myMPD CGI (config/status web UI)"
	default y
	help
		Provides the freetz CGI configuration page and status page for myMPD.
		This is the same symbol shown in "Packages -> Web interfaces".

endif