config FREETZ_PACKAGE_PARTCLONE
	bool "partclone 0.3.31 (binary only)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	select FREETZ_LIB_libcrypto
	select FREETZ_LIB_libblkid
	select FREETZ_LIB_libcom_err
	select FREETZ_LIB_libext2fs
	select FREETZ_LIB_libncursesw
	select FREETZ_LIB_libntfs
	select FREETZ_LIB_libuuid
	default n
	help
		Partclone provides block-level clone/restore/check tools.
		This package installs generic engines plus extended filesystem
		backends (extfs, xfs, ntfs, btrfs, exfat, f2fs, fat, minix, apfs,
		hfsp) and ncursesw support.
		
		Requires uClibc 1.0.58 or newer (needs libblkid from
		util-linux 2.41, which is unavailable on older toolchains).
