+static void die_bind_error(const char *address)
+{
+	if (addr.sa.sa_family == AF_UNIX &&
+	    (errno == EPERM || errno == EACCES || errno == EOPNOTSUPP)) {
+		die("bind: %s\n"
+		    "cmus needs to create the UNIX socket %s.\n"
+		    "This usually happens when HOME, CMUS_HOME, XDG_CONFIG_HOME, XDG_RUNTIME_DIR or CMUS_SOCKET points to a filesystem\n"
+		    "that does not support UNIX sockets (common on non-EXT4 USB/NAS filesystems on this target).\n"
+		    "Try HOME=/tmp cmus or point CMUS_HOME / CMUS_SOCKET to a local EXT4 path.\n",
+		    strerror(errno), address);
+	}
+	die_errno("bind");
+}
