menuconfig FREETZ_PACKAGE_PYTHON3_PYTURBOJPEG
	bool "pyturbojpeg 2.2.0/1.8.3"
	depends on FREETZ_PACKAGE_PYTHON3
	select FREETZ_PACKAGE_PYTHON3_NUMPY
	default n
	help
		Python wrapper for libjpeg-turbo (TurboJPEG API).

if FREETZ_PACKAGE_PYTHON3_PYTURBOJPEG

	choice
		prompt "Version"
		default FREETZ_PACKAGE_PYTHON3_PYTURBOJPEG_VERSION_CURRENT

		config FREETZ_PACKAGE_PYTHON3_PYTURBOJPEG_VERSION_ABANDON
			bool "1.8.3"

		config FREETZ_PACKAGE_PYTHON3_PYTURBOJPEG_VERSION_CURRENT
			bool "2.2.0"
	endchoice

endif
