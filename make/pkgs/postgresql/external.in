config EXTERNAL_FREETZ_PACKAGE_POSTGRESQL
	depends on EXTERNAL_ENABLED && FREETZ_PACKAGE_POSTGRESQL
	bool "PostgreSQL client tools"
	default n
	help
		externals the following file(s):
		 /usr/bin/psql

if EXTERNAL_FREETZ_PACKAGE_POSTGRESQL

config EXTERNAL_FREETZ_PACKAGE_POSTGRESQL_SERVER
	depends on FREETZ_PACKAGE_POSTGRESQL_SERVER
	bool "PostgreSQL server binaries and bootstrap data"
	default y
	help
		externals the following file(s)/directory:
		 /usr/sbin/postgres
		 /usr/bin/pg_ctl
		 /usr/bin/initdb
		 /usr/share/postgresql

endif
