config FREETZ_PACKAGE_PYTHON3_MIIO
	bool "python-miio 0.5.12"
	depends on FREETZ_PACKAGE_PYTHON3
	select FREETZ_PACKAGE_PYTHON3_ANDROID_BACKUP
	select FREETZ_PACKAGE_PYTHON3_APPDIRS
	select FREETZ_PACKAGE_PYTHON3_ATTRS
	select FREETZ_PACKAGE_PYTHON3_CLICK
	select FREETZ_PACKAGE_PYTHON3_CONSTRUCT
	select FREETZ_PACKAGE_PYTHON3_CRONITER
	select FREETZ_PACKAGE_PYTHON3_CRYPTOGRAPHY
	select FREETZ_PACKAGE_PYTHON3_DEFUSEDXML
	select FREETZ_PACKAGE_PYTHON3_MICLOUD
	select FREETZ_PACKAGE_PYTHON3_NETIFACES
	select FREETZ_PACKAGE_PYTHON3_PYTZ
	select FREETZ_PACKAGE_PYTHON3_PYYAML
	select FREETZ_PACKAGE_PYTHON3_TQDM
	select FREETZ_PACKAGE_PYTHON3_ZEROCONF
	default n
	help
		python-miio: control of Xiaomi devices over the LAN (the `miio` module and `miiocli`).
