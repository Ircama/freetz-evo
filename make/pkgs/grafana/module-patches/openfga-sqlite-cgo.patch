+package sqlite
+
+import (
+	"database/sql"
+	"database/sql/driver"
+	"fmt"
+	"net/url"
+	"strings"
+
+	sqlite3 "github.com/mattn/go-sqlite3"
+)
+
+type freetzDriver struct{}
+
+func (d *freetzDriver) Open(dsn string) (driver.Conn, error) {
+	var pragmas []string
+	if pos := strings.IndexByte(dsn, '?'); pos >= 0 {
+		query, err := url.ParseQuery(dsn[pos+1:])
+		if err != nil {
+			return nil, fmt.Errorf("parse SQLite DSN: %w", err)
+		}
+		pragmas = query["_pragma"]
+		query.Del("_pragma")
+		dsn = dsn[:pos] + "?" + query.Encode()
+	}
+	driver := sqlite3.SQLiteDriver{
+		ConnectHook: func(conn *sqlite3.SQLiteConn) error {
+			for _, pragma := range pragmas {
+				if _, err := conn.Exec("PRAGMA "+pragma, nil); err != nil {
+					return fmt.Errorf("apply SQLite pragma %q: %w", pragma, err)
+				}
+			}
+			return nil
+		},
+	}
+	return driver.Open(dsn)
+}
+
+func init() {
+	sql.Register("sqlite", &freetzDriver{})
+}
