@@ -0,0 +1,48 @@
+package sqlite
+
+import (
+	"database/sql"
+	"net/url"
+	"path/filepath"
+	"testing"
+)
+
+func TestFreetzPragmas(t *testing.T) {
+	query := url.Values{}
+	query.Add("_pragma", "journal_mode(WAL)")
+	query.Add("_pragma", "busy_timeout(100)")
+	query.Add("_pragma", "foreign_keys(ON)")
+	query.Set("_txlock", "immediate")
+	db, err := sql.Open("sqlite", "file:"+filepath.Join(t.TempDir(), "test.db")+"?"+query.Encode())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	for pragma, want := range map[string]string{
+		"journal_mode": "wal",
+		"busy_timeout": "100",
+		"foreign_keys": "1",
+	} {
+		var got string
+		if err := db.QueryRow("PRAGMA " + pragma).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Fatalf("%s: got %q, want %q", pragma, got, want)
+		}
+	}
+}
+
+func TestFreetzInvalidDSN(t *testing.T) {
+	for _, dsn := range []string{
+		"file::memory:?_pragma=%zz",
+		"file::memory:?_pragma=busy_timeout(",
+	} {
+		conn, err := (&freetzDriver{}).Open(dsn)
+		if err == nil {
+			conn.Close()
+			t.Fatalf("expected invalid DSN or pragma to fail: %s", dsn)
+		}
+	}
+}
