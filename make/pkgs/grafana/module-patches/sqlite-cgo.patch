+//go:build cgo && freetz_sqlite_cgo
+
+package sqlite
+
+import (
+	"errors"
+
+	sqlite3 "github.com/mattn/go-sqlite3"
+)
+
+type Driver = sqlite3.SQLiteDriver
+
+var (
+	ErrTestUniqueConstraintViolation = errors.New("unique constraint violation (simulated)")
+	ErrTestBusy                      = errors.New("database is busy (simulated)")
+	ErrTestLocked                    = errors.New("database is locked (simulated)")
+)
+
+func DriverType() string {
+	return "github.com/mattn/go-sqlite3"
+}
+
+func IsBusyOrLocked(err error) bool {
+	var sqliteErr sqlite3.Error
+	if errors.As(err, &sqliteErr) {
+		return sqliteErr.Code == sqlite3.ErrBusy || sqliteErr.Code == sqlite3.ErrLocked
+	}
+	return errors.Is(err, ErrTestBusy) || errors.Is(err, ErrTestLocked)
+}
+
+func IsUniqueConstraintViolation(err error) bool {
+	var sqliteErr sqlite3.Error
+	if errors.As(err, &sqliteErr) {
+		return sqliteErr.ExtendedCode == sqlite3.ErrConstraintPrimaryKey ||
+			sqliteErr.ExtendedCode == sqlite3.ErrConstraintUnique
+	}
+	return errors.Is(err, ErrTestUniqueConstraintViolation)
+}
+
+func ErrorMessage(err error) string {
+	var sqliteErr sqlite3.Error
+	if errors.As(err, &sqliteErr) {
+		return sqliteErr.Error()
+	}
+	return err.Error()
+}
