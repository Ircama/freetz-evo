@@ -0,0 +1,85 @@
+//go:build cgo && freetz_sqlite_cgo
+
+package sqlite
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+
+	sqlite3 "github.com/mattn/go-sqlite3"
+)
+
+func TestFreetzSQLite(t *testing.T) {
+	db, err := sql.Open("sqlite3", "file:"+filepath.Join(t.TempDir(), "test.db")+"?cache=shared&_busy_timeout=7500&_journal_mode=WAL")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+
+	for pragma, want := range map[string]string{"busy_timeout": "7500", "journal_mode": "wal"} {
+		var got string
+		if err := db.QueryRow("PRAGMA " + pragma).Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		if got != want {
+			t.Fatalf("%s: got %q, want %q", pragma, got, want)
+		}
+	}
+	if _, err := db.Exec("CREATE TABLE test (id INTEGER PRIMARY KEY, name TEXT UNIQUE, timestamp DATETIME)"); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC().Round(time.Microsecond)
+	if _, err := db.Exec("INSERT INTO test VALUES (?, ?, ?)", 1, "one", now); err != nil {
+		t.Fatal(err)
+	}
+	var got time.Time
+	if err := db.QueryRow("SELECT timestamp FROM test WHERE id = 1").Scan(&got); err != nil {
+		t.Fatal(err)
+	}
+	if !got.Equal(now) {
+		t.Fatalf("timestamp: got %s, want %s", got, now)
+	}
+	for _, query := range []string{
+		"INSERT INTO test (id, name) VALUES (1, 'two')",
+		"INSERT INTO test (id, name) VALUES (2, 'one')",
+	} {
+		_, err := db.Exec(query)
+		if err == nil || !IsUniqueConstraintViolation(fmt.Errorf("wrapped: %w", err)) {
+			t.Fatalf("expected unique constraint violation, got %v", err)
+		}
+		if ErrorMessage(fmt.Errorf("wrapped: %w", err)) != err.Error() {
+			t.Fatalf("unexpected SQLite error message for %v", err)
+		}
+	}
+}
+
+func TestFreetzSQLiteErrors(t *testing.T) {
+	for _, err := range []error{
+		sqlite3.Error{Code: sqlite3.ErrBusy},
+		sqlite3.Error{Code: sqlite3.ErrLocked},
+		ErrTestBusy,
+		ErrTestLocked,
+	} {
+		if !IsBusyOrLocked(fmt.Errorf("wrapped: %w", err)) {
+			t.Fatalf("expected busy/locked error, got %v", err)
+		}
+	}
+	if !IsUniqueConstraintViolation(fmt.Errorf("wrapped: %w", ErrTestUniqueConstraintViolation)) {
+		t.Fatal("expected simulated unique constraint violation")
+	}
+	other := errors.New("other")
+	if IsBusyOrLocked(other) || IsUniqueConstraintViolation(other) {
+		t.Fatal("unrelated error classified as SQLite error")
+	}
+	if IsBusyOrLocked(nil) || IsUniqueConstraintViolation(nil) {
+		t.Fatal("nil classified as SQLite error")
+	}
+	if ErrorMessage(other) != other.Error() {
+		t.Fatal("unrelated error message changed")
+	}
+}
