#!/bin/sh
# Pi-hole save hooks for freetz-ng
# Called by modconf framework during save operations

pkg_pre_save() {
	# Pre-flight validation

	# Check if basedir is writable when enabled
	if [ "$PIHOLE_ENABLED" = "yes" ] && [ -n "$PIHOLE_BASEDIR" ]; then
		if ! mkdir -p "$PIHOLE_BASEDIR" 2>/dev/null; then
			echo "Warning: Base directory not writable: ${PIHOLE_BASEDIR}" >&2
		fi
	fi

	# Validate dnsmasq is available
	if [ "$PIHOLE_ENABLED" = "yes" ]; then
		if ! command -v dnsmasq >/dev/null 2>&1; then
			echo "Error: dnsmasq not found" >&2
			return 1
		fi
	fi

	return 0
}

pkg_apply_save() {
	# Apply changes AFTER framework has saved config
	# Re-source to get persisted values
	[ -r /mod/etc/conf/pi-hole.cfg ] && . /mod/etc/conf/pi-hole.cfg

	# Create required directories
	mkdir -p "${PIHOLE_BASEDIR}" \
		"${PIHOLE_BASEDIR}/dnsmasq.d" \
		/tmp/flash/dnsmasq 2>/dev/null

	# If enabled, generate dnsmasq configuration
	if [ "$PIHOLE_ENABLED" = "yes" ]; then
		local dnsmasq_conf="${PIHOLE_BASEDIR}/dnsmasq.d/99-pi-hole.conf"
		{
			echo "# Pi-hole dnsmasq configuration"
			echo "# Generated by Pi-hole save hook"
			echo ""
			echo "# Upstream DNS servers"
			for dns in $PIHOLE_DNS_UPSTREAM; do
				echo "server=${dns}"
			done
			echo ""
			echo "# Blocklist hosts file"
			echo "addn-hosts=${PIHOLE_BASEDIR}/pi-hole.hosts"
			echo ""
			echo "# Rate limiting"
			echo "dns-forward-max=${PIHOLE_RATE_LIMIT:-1000}"
			echo ""
			# Logging
			case "${PIHOLE_LOG_LEVEL:-0}" in
				1) echo "log-queries" ;;
				2) echo "log-queries" ; echo "log-facility=/var/log/dnsmasq.log" ;;
			esac
		} > "$dnsmasq_conf"

		# Ensure dnsmasq includes our config
		mkdir -p /etc/dnsmasq.d 2>/dev/null
		ln -sf "$dnsmasq_conf" /etc/dnsmasq.d/99-pi-hole.conf 2>/dev/null || true

		# Run gravity to download and compile blocklists
		if [ -x /usr/share/pi-hole/gravity.sh ]; then
			sh /usr/share/pi-hole/gravity.sh >/dev/null 2>&1 &
		fi

		# Signal dnsmasq to reload config
		killall -HUP dnsmasq 2>/dev/null || true
	else
		# Disable: remove our config
		rm -f /etc/dnsmasq.d/99-pi-hole.conf 2>/dev/null
		rm -f "${PIHOLE_BASEDIR}/dnsmasq.d/99-pi-hole.conf" 2>/dev/null
		killall -HUP dnsmasq 2>/dev/null || true
	fi

	return 0
}
