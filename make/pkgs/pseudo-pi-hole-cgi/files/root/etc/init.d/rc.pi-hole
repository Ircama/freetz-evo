#!/bin/sh

DAEMON=pi-hole
PID_FILE=/var/run/$DAEMON.pid
. /etc/init.d/modlibrc

# Load persistent configuration
[ -r /mod/etc/conf/pi-hole.cfg ] && . /mod/etc/conf/pi-hole.cfg

# Defaults
: "${PIHOLE_ENABLED:=no}"
: "${PIHOLE_BASEDIR:=/tmp/flash/pi-hole}"
: "${PIHOLE_CONFIG_WAIT:=30}"
: "${PIHOLE_DNSMASQ_CONF_DIR:=/tmp/flash/dnsmasq}"

# Check if dnsmasq is running
is_running() {
	pidof dnsmasq >/dev/null 2>&1 && return 0
	return 1
}

# Wait for directory availability (USB mount, etc.)
wait_for_directory() {
	local dir="$1"
	local max_wait="${2:-120}"
	local elapsed=0

	while [ $elapsed -lt $max_wait ]; do
		if [ -d "$dir" ]; then
			return 0
		fi
		sleep 2
		elapsed=$((elapsed + 2))
	done

	return 1
}

# Setup Pi-hole environment
setup() {
	# Create required directories
	mkdir -p "${PIHOLE_BASEDIR}" "${PIHOLE_DNSMASQ_CONF_DIR}" /etc/dnsmasq.d 2>/dev/null

	# Register with mod
	modreg cgi 'pi-hole' 'Pi-hole'
}

# Configure dnsmasq for Pi-hole
configure_dnsmasq() {
	local conf_file="${PIHOLE_BASEDIR}/dnsmasq.d/99-pi-hole.conf"
	local hosts_file="${PIHOLE_DNSMASQ_CONF_DIR}/pi-hole.hosts"

	mkdir -p "${PIHOLE_BASEDIR}/dnsmasq.d" 2>/dev/null

	if [ ! -f "$conf_file" ]; then
		{
			echo "# Pi-hole dnsmasq configuration"
			echo "# Generated by rc.pi-hole init script"
			echo ""
			echo "# Upstream DNS servers"
			for dns in $PIHOLE_DNS_UPSTREAM; do
				echo "server=${dns}"
			done
			echo ""
			echo "# Blocklist hosts file"
			echo "addn-hosts=${hosts_file}"
		} > "$conf_file"
	fi

	# Create symlink in dnsmasq.d
	if [ -f "$conf_file" ] && [ ! -L /etc/dnsmasq.d/99-pi-hole.conf ]; then
		ln -sf "$conf_file" /etc/dnsmasq.d/99-pi-hole.conf 2>/dev/null || true
	fi
}

# Load blocklists with initial gravity run
run_gravity() {
	if [ -x /usr/share/pi-hole/gravity.sh ]; then
		echo "Running initial gravity update..."
		sh /usr/share/pi-hole/gravity.sh >/dev/null 2>&1 || true
	fi
}

# Start Pi-hole (configure dnsmasq)
start() {
	echo "Starting ${DAEMON}..."

	if [ -z "$PIHOLE_BASEDIR" ]; then
		echo "failed: No base directory configured."
		exit 1
	fi

	# Create directories
	mkdir -p "${PIHOLE_BASEDIR}" "${PIHOLE_BASEDIR}/dnsmasq.d" 2>/dev/null

	# Configure dnsmasq
	configure_dnsmasq

	# Run gravity to get initial blocklists
	if [ "$PIHOLE_ENABLED" = "yes" ]; then
		# Run gravity in background (may take time)
		run_gravity &
	fi

	# Signal dnsmasq to reload
	if is_running; then
		killall -HUP dnsmasq 2>/dev/null || true
	fi

	echo 'done.'
}

# Stop Pi-hole (remove dnsmasq config)
stop() {
	echo "Stopping ${DAEMON}..."

	# Remove our dnsmasq config
	rm -f /etc/dnsmasq.d/99-pi-hole.conf 2>/dev/null
	rm -f "${PIHOLE_BASEDIR}/dnsmasq.d/99-pi-hole.conf" 2>/dev/null

	# Signal dnsmasq to reload
	if is_running; then
		killall -HUP dnsmasq 2>/dev/null || true
	fi

	echo 'done.'
}

# Main case statement
case $1 in
	""|load)
		setup
		modreg daemon $DAEMON

		if [ "$PIHOLE_ENABLED" = "yes" ]; then
			basedir="${PIHOLE_BASEDIR}"
			wait_time="${PIHOLE_CONFIG_WAIT:-30}"

			if [ -n "$basedir" ]; then
				echo "${DAEMON} will start in background..."
				# Launch in background with nohup
				(
					# Re-source config in subshell
					. /etc/init.d/modlibrc
					[ -r /mod/etc/conf/pi-hole.cfg ] && . /mod/etc/conf/pi-hole.cfg

					wait_time="${PIHOLE_CONFIG_WAIT:-30}"
					if [ "$wait_time" != "0" ]; then
						wait_for_directory "$basedir" "$wait_time"
					fi

					start
				) >/dev/null 2>&1 &
			else
				echo "${DAEMON}: base directory not configured, skipped."
			fi
		fi
		;;
	unload)
		modunreg daemon $DAEMON
		modunreg cgi 'pi-hole'
		stop
		;;
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		sleep 1
		start
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|status]" 1>&2
		exit 1
		;;
esac

exit 0
