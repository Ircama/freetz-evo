$(call PKG_INIT_BIN, 25.12)
$(PKG)_SOURCE_DOWNLOAD_NAME:=$($(PKG)_VERSION).tar.gz
$(PKG)_SOURCE:=$(pkg)-$($(PKG)_VERSION).tar.gz
$(PKG)_HASH:=d283ec7a41a02d398e8918b20b65df3bf684cf4478371830662004005dadcdd2
$(PKG)_SITE:=https://github.com/merbanan/rtl_433/archive/refs/tags
### WEBSITE:=https://triq.org/
### CHANGES:=https://github.com/merbanan/rtl_433/releases
### CVSREPO:=https://github.com/merbanan/rtl_433

$(PKG)_CATEGORY_PKGS:=Home Automation

$(PKG)_BINARY:=$($(PKG)_DIR)/src/rtl_433
$(PKG)_TARGET_BINARY:=$($(PKG)_DEST_DIR)/usr/bin/rtl_433

$(PKG)_DEPENDS_ON += cmake-host
$(PKG)_DEPENDS_ON += rtl-sdr
$(PKG)_DEPENDS_ON += libusb1

ifeq ($(strip $(FREETZ_PACKAGE_RTL_433_WITH_SOAPYSDR)),y)
$(PKG)_DEPENDS_ON += soapysdr
endif

ifeq ($(strip $(FREETZ_PACKAGE_RTL_433_WITH_OPENSSL)),y)
$(PKG)_DEPENDS_ON += openssl
endif

$(PKG)_REBUILD_SUBOPTS += FREETZ_LIB_rtl_sdr
$(PKG)_REBUILD_SUBOPTS += FREETZ_PACKAGE_RTL_433_WITH_SOAPYSDR
$(PKG)_REBUILD_SUBOPTS += FREETZ_PACKAGE_RTL_433_WITH_OPENSSL

$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_INSTALL_PREFIX="/usr"
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_SKIP_RPATH=YES
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_BUILD_TYPE=Release
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_SYSTEM_NAME=Linux
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_SYSTEM_PROCESSOR=$(FREETZ_TARGET_ARCH)
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_FIND_ROOT_PATH="$(TARGET_TOOLCHAIN_STAGING_DIR)"
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
$(PKG)_CONFIGURE_OPTIONS += -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY

# rtl_433 build options
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_RTLSDR=ON
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_THREADS=ON
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_IPV6=ON
$(PKG)_CONFIGURE_OPTIONS += -DBUILD_TESTING=OFF
$(PKG)_CONFIGURE_OPTIONS += -DBUILD_DOCUMENTATION=OFF

# SoapySDR input support: rtl_433 uses find_package(SoapySDR "0.6" NO_MODULE),
# so point it at the cmake package config installed by the soapysdr package.
ifeq ($(strip $(FREETZ_PACKAGE_RTL_433_WITH_SOAPYSDR)),y)
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_SOAPYSDR=ON
$(PKG)_CONFIGURE_OPTIONS += -DSoapySDR_DIR="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/share/cmake/SoapySDR"
else
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_SOAPYSDR=OFF
endif

# OpenSSL (TLS) support for MQTT/InfluxDB. The libraries are pinned explicitly
# so that the host OpenSSL can never be picked up by find_package(OpenSSL).
ifeq ($(strip $(FREETZ_PACKAGE_RTL_433_WITH_OPENSSL)),y)
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_OPENSSL=ON
$(PKG)_CONFIGURE_OPTIONS += -DOPENSSL_ROOT_DIR="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr"
$(PKG)_CONFIGURE_OPTIONS += -DOPENSSL_INCLUDE_DIR="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/include"
$(PKG)_CONFIGURE_OPTIONS += -DOPENSSL_SSL_LIBRARY="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/lib/libssl.so"
$(PKG)_CONFIGURE_OPTIONS += -DOPENSSL_CRYPTO_LIBRARY="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/lib/libcrypto.so"
else
$(PKG)_CONFIGURE_OPTIONS += -DENABLE_OPENSSL=OFF
endif

# Point cmake's find_* at the staged librtlsdr (installed by rtl-sdr)
$(PKG)_CONFIGURE_OPTIONS += -DLIBRTLSDR_INCLUDE_DIR="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/include"
$(PKG)_CONFIGURE_OPTIONS += -DLIBRTLSDR_LIBRARY="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/lib/librtlsdr.so"
$(PKG)_CONFIGURE_OPTIONS += -DLIBUSB_INCLUDE_DIR="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/include/libusb-1.0"
$(PKG)_CONFIGURE_OPTIONS += -DLIBUSB_LIBRARY="$(TARGET_TOOLCHAIN_STAGING_DIR)/usr/lib/libusb-1.0.so"

$(PKG_SOURCE_DOWNLOAD)
$(PKG_UNPACKED)
$(PKG_CONFIGURED_CMAKE)

$($(PKG)_BINARY): $($(PKG)_DIR)/.configured
	$(SUBMAKE) -C $(RTL_433_DIR)

$($(PKG)_TARGET_BINARY): $($(PKG)_BINARY)
	$(INSTALL_BINARY_STRIP)

$(pkg):

$(pkg)-precompiled: $($(PKG)_TARGET_BINARY)


$(pkg)-clean:
	-$(SUBMAKE) -C $(RTL_433_DIR) clean
	$(RM) $(RTL_433_DIR)/.configured

$(pkg)-uninstall:
	$(RM) $(RTL_433_TARGET_BINARY)

$(PKG_FINISH)