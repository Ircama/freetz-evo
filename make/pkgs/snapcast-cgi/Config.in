config FREETZ_PACKAGE_SNAPCAST_CGI
	bool "snapcast CGI (Snapserver/snapclient config/status web UI)"
	depends on FREETZ_PACKAGE_SNAPCAST
	select FREETZ_BUSYBOX_START_STOP_DAEMON
	default y
	help
		Provides the freetz CGI configuration page and status page for
		snapcast.

		Includes startup handling, generated snapserver.conf management and
		live status output for snapserver and the optional local snapclient.

		http://fritz.box:81/cgi-bin/conf/snapcast