config FREETZ_PACKAGE_PYTHON3_HASS_NABUCASA
	bool "hass-nabucasa 2.2.0"
	depends on FREETZ_PACKAGE_PYTHON3
	depends on FREETZ_TARGET_UCLIBC_1_0_58_MIN
	select FREETZ_PACKAGE_PYTHON3_AIOHTTP
	select FREETZ_PACKAGE_PYTHON3_ATTRS
	select FREETZ_PACKAGE_PYTHON3_CISO8601
	select FREETZ_PACKAGE_PYTHON3_CRYPTOGRAPHY
	select FREETZ_PACKAGE_PYTHON3_GRPCIO
	select FREETZ_PACKAGE_PYTHON3_VOLUPTUOUS
	select FREETZ_PACKAGE_PYTHON3_WEBRTC_MODELS
	select FREETZ_PACKAGE_PYTHON3_YARL
	default n
	help
		Nabu Casa client library used by Home Assistant cloud integrations.
