config FREETZ_PACKAGE_FSARCHIVER
	bool "fsarchiver 0.8.9 (binary only)"
	depends on FREETZ_TARGET_UCLIBC_1_0_58
	select FREETZ_LIB_libz
	select FREETZ_LIB_libbz2
	select FREETZ_LIB_libgcrypt
	select FREETZ_LIB_libblkid
	select FREETZ_LIB_libcom_err
	select FREETZ_LIB_libe2p
	select FREETZ_LIB_libext2fs
	select FREETZ_LIB_libuuid
	default n
	help
		fsarchiver is a filesystem archiver with restore capabilities.
		This package is built with conservative compression support
		(disabling lzma/lzo/lz4/zstd) to keep dependencies smaller.
		
		Requires uClibc 1.0.58 or newer (needs libblkid from
		util-linux 2.41, which is unavailable on older toolchains).
