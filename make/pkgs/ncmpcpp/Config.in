config FREETZ_PACKAGE_NCMPCPP
	bool "ncmpcpp 0.9.2"
	depends on FREETZ_TARGET_UCLIBC_1_0_58
	select FREETZ_LIB_libmpdclient
	select FREETZ_LIB_libncursesw
	select FREETZ_LIB_libcurl
	select FREETZ_LIB_libtag
	default n
	help
		Ncurses-based MPD client. Feature-rich terminal user interface
		for controlling the Music Player Daemon.
		
		Requires uClibc 1.0.58 or newer (it also depends on taglib).
