CAPTION='Freetz Proxy: Services'
DESCRIPTION='Defines services accessible through the HTTPS proxy.
Format: <tt>name=port[:path[:direct]]</tt> (one entry per line).
With <tt>direct</tt> the index link opens the native HTTP URL directly.
<br><br>
<b>Security directives</b> (<tt>@key=yes|no</tt>):
<br><tt>@disabled=yes</tt> — Disable the proxy entirely; every request returns a notice page.
<br><tt>@block_internet=yes</tt> — Block all access from internet (*.myfritz.net), returns 403.
<br><tt>@no_internet_cookie=yes</tt> — Strip <tt>Max-Age</tt>/<tt>Expires</tt> from cookies when accessed from internet; sessions expire on browser close (default: yes).
<br><tt>@no_cookie=yes</tt> — Strip <tt>Max-Age</tt>/<tt>Expires</tt> from all cookies regardless of origin.'
CONFIG_FILE='/tmp/flash/mod/freetz-proxy.cfg'
CONFIG_SAVE='modsave flash;'
CONFIG_TYPE='text'
TEXT_ROWS=28
