#!/bin/sh

DAEMON=freetz-proxy
. /etc/init.d/modlibrc

case $1 in
""|load)
# Inizializza il file flash dal template servizi se non esiste ancora
# (prima volta dopo l'installazione del firmware).
if [ ! -f /tmp/flash/mod/freetz-proxy.cfg ]; then
for src in \
/mod/external/etc/default.freetz-proxy/freetz-proxy-services.cfg \
/mod/etc/default.freetz-proxy/freetz-proxy-services.cfg \
/etc/default.freetz-proxy/freetz-proxy-services.cfg; do
if [ -r "$src" ]; then
cp "$src" /tmp/flash/mod/freetz-proxy.cfg
break
fi
done
fi

# Prepara /mod/usr/lib/cgi-bin/mod/ affinche' includa il nostro CGI.
# /mod/usr/lib/cgi-bin/mod e' normalmente un symlink verso /usr/lib/cgi-bin/mod (ro)
# Lo sostituiamo con una directory con symlink ai file originali + il nostro CGI.
CGI_MOD=/mod/usr/lib/cgi-bin/mod
if [ -L "$CGI_MOD" ] || [ ! -d "$CGI_MOD" ]; then
rm -f "$CGI_MOD"
mkdir -p "$CGI_MOD"
for f in /usr/lib/cgi-bin/mod/*; do
[ -e "$f" ] && ln -sf "$f" "$CGI_MOD/$(basename "$f")"
done
fi

# Crea symlink al CGI freetz-proxy nella directory mod/
for src in \
/mod/external/usr/lib/cgi-bin/freetz-proxy.cgi \
/usr/lib/cgi-bin/freetz-proxy.cgi; do
if [ -e "$src" ]; then
ln -sf "$src" "$CGI_MOD/freetz-proxy.cgi"
break
fi
done

# Rimuovi la vecchia registrazione standalone se presente (migrazione)
grep -q "^freetz-proxy|" /mod/etc/reg/pkg.reg  2>/dev/null && modunreg pkg  freetz-proxy 2>/dev/null || true
grep -q "^freetz-proxy|" /mod/etc/reg/conf.reg 2>/dev/null && modunreg conf freetz-proxy 2>/dev/null || true

# Registra sotto il menu Freetz (mod) -> URL: /cgi-bin/extra/mod/freetz-proxy
[ -e "$CGI_MOD/freetz-proxy.cgi" ] && modreg extra mod 'Freetz Proxy' 0 freetz-proxy
;;
unload)
modunreg extra mod freetz-proxy 2>/dev/null || true
rm -f /mod/usr/lib/cgi-bin/mod/freetz-proxy.cgi
;;
status)
if [ -x /mod/external/usr/www/cgi-bin/freetz_proxy ] || \
   [ -x /usr/www/cgi-bin/freetz_proxy ]; then
echo "freetz_proxy is installed."
else
echo "freetz_proxy is NOT installed."
fi
;;
*)
echo "Usage: $0 [load|unload|status]" 1>&2
exit 1
;;
esac

exit 0
