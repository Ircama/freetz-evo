#!/bin/sh

DAEMON=freetz-proxy
. /etc/init.d/modlibrc

# Locate the .def file (squashfs → /mod/etc symlink → external deploy path).
PROXY_DEF=/etc/default.freetz-proxy/freetz-proxy-cfg.def
[ -r /mod/etc/default.freetz-proxy/freetz-proxy-cfg.def ] && \
PROXY_DEF=/mod/etc/default.freetz-proxy/freetz-proxy-cfg.def
[ -r /mod/external/etc/default.freetz-proxy/freetz-proxy-cfg.def ] && \
PROXY_DEF=/mod/external/etc/default.freetz-proxy/freetz-proxy-cfg.def

case $1 in
""|load)
# Initialize flash config from services template if not yet present
# (first boot after firmware installation).
if [ ! -f /tmp/flash/mod/freetz-proxy.cfg ]; then
for src in \
/mod/external/etc/default.freetz-proxy/freetz-proxy-services.cfg \
/mod/etc/default.freetz-proxy/freetz-proxy-services.cfg \
/etc/default.freetz-proxy/freetz-proxy-services.cfg; do
if [ -r "$src" ]; then
cp "$src" /tmp/flash/mod/freetz-proxy.cfg
break
fi
done
fi

# Register the config file text editor under the Freetz menu (mod).
# URL: /cgi-bin/file/mod/freetz_proxy
modreg file mod freetz_proxy \
"freetz-proxy" \
0 "$PROXY_DEF"
;;
unload)
modunreg file  mod freetz_proxy   2>/dev/null || true
;;
status)
if [ -x /mod/external/usr/www/cgi-bin/freetz_proxy ] || \
   [ -x /usr/www/cgi-bin/freetz_proxy ]; then
echo "freetz_proxy is installed."
else
echo "freetz_proxy is NOT installed."
fi
;;
*)
echo "Usage: $0 [load|unload|status]" 1>&2
exit 1
;;
esac

exit 0
