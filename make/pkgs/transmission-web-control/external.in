config EXTERNAL_FREETZ_PACKAGE_TRANSMISSION_WEB_CONTROL
	depends on EXTERNAL_ENABLED && FREETZ_PACKAGE_TRANSMISSION_WEB_CONTROL
	bool "transmission-web-control"
	default n
	help
		externals the following file(s):
		 /usr/mww/transmission-web-control
		 /usr/share/transmission-web-home/transmission-web-control
