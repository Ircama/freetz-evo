config FREETZ_PACKAGE_PYTHON3_AIOHTTP
	bool "aiohttp 3.13.5"
	depends on FREETZ_PACKAGE_PYTHON3
	select FREETZ_PACKAGE_PYTHON3_AIOHAPPYEYEBALLS
	select FREETZ_PACKAGE_PYTHON3_AIOSIGNAL
	select FREETZ_PACKAGE_PYTHON3_ASYNC_TIMEOUT
	select FREETZ_PACKAGE_PYTHON3_ATTRS
	select FREETZ_PACKAGE_PYTHON3_CHARSET_NORMALIZER
	select FREETZ_PACKAGE_PYTHON3_FROZENLIST
	select FREETZ_PACKAGE_PYTHON3_MULTIDICT
	select FREETZ_PACKAGE_PYTHON3_YARL
	default n
	help
		aiohttp is an asynchronous HTTP client/server framework for asyncio.
