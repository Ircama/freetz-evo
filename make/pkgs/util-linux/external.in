config EXTERNAL_FREETZ_PACKAGE_UTIL_LINUX
	depends on EXTERNAL_ENABLED && FREETZ_PACKAGE_UTIL_LINUX
	bool "util-linux"
	default n
	help
		externals the following file(s):
		
		Version 2.27.1 (legacy):
		 /sbin/blkid-util-linux
		
		Version 2.41 (modern):
		 /sbin/blkid-util-linux
		 /sbin/fdisk-util-linux
		 /sbin/sfdisk-util-linux
		 /sbin/blockdev-util-linux
		 /sbin/blockdev-ng
		 /sbin/partx
		 /sbin/addpart
		 /sbin/delpart
		 /sbin/resizepart
		 /sbin/findfs
		 /sbin/wipefs
		 /sbin/cfdisk
		 /sbin/lsblk
		 /sbin/lsfd
		 /sbin/findmnt
		 /sbin/mountpoint
		 /sbin/losetup-util-linux
		 /sbin/mkswap-util-linux
		 /sbin/swapon-util-linux
		 /sbin/swapoff-util-linux
		 /sbin/unshare-util-linux
		 /sbin/uuidgen-util-linux
		 /sbin/uuidparse
		 /sbin/lastlog2

