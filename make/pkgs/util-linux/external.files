if [ "$EXTERNAL_FREETZ_PACKAGE_UTIL_LINUX" == "y" ]; then
	[ "$FREETZ_UTIL_LINUX_BLKID" == "y" ] && EXTERNAL_FILES+=" /sbin/blkid-util-linux"
	[ "$FREETZ_UTIL_LINUX_FDISK" == "y" ] && EXTERNAL_FILES+=" /sbin/fdisk-util-linux"
	[ "$FREETZ_UTIL_LINUX_SFDISK" == "y" ] && EXTERNAL_FILES+=" /sbin/sfdisk-util-linux"
	[ "$FREETZ_UTIL_LINUX_BLOCKDEV" == "y" ] && EXTERNAL_FILES+=" /sbin/blockdev-util-linux"
	[ "$FREETZ_UTIL_LINUX_BLOCKDEV" == "y" ] && EXTERNAL_FILES+=" /sbin/blockdev-ng"
	[ "$FREETZ_UTIL_LINUX_PARTX" == "y" ] && EXTERNAL_FILES+=" /sbin/partx /sbin/addpart /sbin/delpart /sbin/resizepart"
	[ "$FREETZ_UTIL_LINUX_FINDFS" == "y" ] && EXTERNAL_FILES+=" /sbin/findfs"
	[ "$FREETZ_UTIL_LINUX_WIPEFS" == "y" ] && EXTERNAL_FILES+=" /sbin/wipefs"
	[ "$FREETZ_UTIL_LINUX_LOSETUP" == "y" ] && EXTERNAL_FILES+=" /sbin/losetup-util-linux"
	[ "$FREETZ_UTIL_LINUX_MKSWAP" == "y" ] && EXTERNAL_FILES+=" /sbin/mkswap-util-linux"
	[ "$FREETZ_UTIL_LINUX_SWAPON" == "y" ] && EXTERNAL_FILES+=" /sbin/swapon-util-linux"
	[ "$FREETZ_UTIL_LINUX_SWAPON" == "y" ] && EXTERNAL_FILES+=" /sbin/swapoff-util-linux"
	[ "$FREETZ_UTIL_LINUX_LSBLK" == "y" ] && EXTERNAL_FILES+=" /sbin/lsblk"
	[ "$FREETZ_UTIL_LINUX_LSFD" == "y" -a -e "${FILESYSTEM_MOD_DIR}/sbin/lsfd" ] && EXTERNAL_FILES+=" /sbin/lsfd"
	[ "$FREETZ_UTIL_LINUX_FINDMNT" == "y" ] && EXTERNAL_FILES+=" /sbin/findmnt"
	[ "$FREETZ_UTIL_LINUX_CFDISK" == "y" ] && EXTERNAL_FILES+=" /sbin/cfdisk"
	[ "$FREETZ_UTIL_LINUX_UNSHARE" == "y" ] && EXTERNAL_FILES+=" /sbin/unshare-util-linux"
	[ "$FREETZ_UTIL_LINUX_UUIDGEN" == "y" ] && EXTERNAL_FILES+=" /sbin/uuidgen-util-linux"
	[ "$FREETZ_UTIL_LINUX_UUIDPARSE" == "y" ] && EXTERNAL_FILES+=" /sbin/uuidparse"
	[ "$FREETZ_UTIL_LINUX_LASTLOG2" == "y" ] && EXTERNAL_FILES+=" /sbin/lastlog2"
	[ "$FREETZ_UTIL_LINUX_MOUNTPOINT" == "y" ] && EXTERNAL_FILES+=" /sbin/mountpoint"
fi

[ "$EXTERNAL_FREETZ_LIB_libblkid" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libblkid.so.1.1.0"
[ "$EXTERNAL_FREETZ_LIB_libmount" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libmount.so.1.1.0"
[ "$EXTERNAL_FREETZ_LIB_libsmartcols" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libsmartcols.so.1.1.0"
[ "$EXTERNAL_FREETZ_LIB_libfdisk" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libfdisk.so.1.1.0"
[ "$EXTERNAL_FREETZ_LIB_liblastlog2" == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/liblastlog2.so.2.0.0"
