if [ "$EXTERNAL_FREETZ_PACKAGE_UTIL_LINUX" == "y" ]; then
	EXTERNAL_FILES+=" /sbin/blkid-util-linux"
	EXTERNAL_FILES+=" /sbin/losetup-util-linux"
	EXTERNAL_FILES+=" /sbin/mkswap-util-linux"
	EXTERNAL_FILES+=" /sbin/swapon-util-linux"
	EXTERNAL_FILES+=" /sbin/swapoff-util-linux"
	EXTERNAL_FILES+=" /sbin/lsblk"
	EXTERNAL_FILES+=" /sbin/findmnt"
	[ "$FREETZ_UTIL_LINUX_CFDISK" == "y" ] && EXTERNAL_FILES+=" /sbin/cfdisk"
fi
