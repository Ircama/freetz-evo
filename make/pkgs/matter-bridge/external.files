# The two binaries are externalized; the init script, the Freetz configuration
# and the fabric/node store stay in the firmware (the store has to live in
# /tmp/flash to be archived by modsave). The daemon is started with absolute
# paths, so running it from /mod/external/usr/bin needs no adjustment.
[ "$EXTERNAL_FREETZ_PACKAGE_MATTER_BRIDGE" == "y" ] && EXTERNAL_FILES+=" /usr/bin/matter-bridge /usr/bin/matter-bridge-ctl"
