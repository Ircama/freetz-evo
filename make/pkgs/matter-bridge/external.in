config EXTERNAL_FREETZ_PACKAGE_MATTER_BRIDGE
	depends on EXTERNAL_ENABLED && FREETZ_PACKAGE_MATTER_BRIDGE
	bool "matter-bridge"
	default n
	help
		Externalizes the following file(s):
			/usr/bin/matter-bridge

		The WebSocket server binary lives on USB/NAS storage, while the init
		script, the Freetz configuration and the fabric/node store stay in the
		firmware: the store must live in /tmp/flash, where modsave archives it,
		to survive reboots. The daemon is started through absolute paths, so the
		binary works from /mod/external.
