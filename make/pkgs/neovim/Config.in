config FREETZ_PACKAGE_NEOVIM
	bool "Neovim 0.12.2"
	depends on FREETZ_TARGET_GCC_4_9_MIN
	select FREETZ_LIB_libdl       if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libiconv    if FREETZ_TARGET_UCLIBC_0_9_28
	select FREETZ_LIB_libm        if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	select FREETZ_LIB_libpthread  if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	default n
	help
		Modern Vim-based terminal editor.

		This package builds Neovim with the upstream bundled dependencies
		needed by the editor and installs the runtime under /usr/share/nvim.
		Externalization is supported for the editor binary and, when
		EXTERNAL_SUBDIRS is enabled, for /usr/share/nvim and /usr/lib/nvim.

		Requires GCC 4.9 or newer: the bundled libuv uses <stdatomic.h>
		(C11 atomics), which the old GCC 4.6.4 toolchain does not provide
		(fatal error: stdatomic.h: No such file or directory).